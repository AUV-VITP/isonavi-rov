<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="large_river">

    <!-- =================================================================== -->
    <!-- PHYSICS ENGINE CONFIGURATION                                        -->
    <!-- =================================================================== -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo Harmonic Simulation Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>

    <!-- Dynamic Particle Emitter System (Suspended Spherical Dust strictly INSIDE water) -->
    <plugin filename="gz-sim-particle-emitter-system" name="gz::sim::systems::ParticleEmitter"/>

    <!-- Buoyancy: High-density silty flood water (1005 kg/m^3 with suspended sediment) -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1005.0</default_density>
        <density_change>
          <above_depth>0.0</above_depth>
          <density>1.2</density>
        </density_change>
      </graded_buoyancy>
      <enable>isonavi_rov::base_link</enable>
    </plugin>

    <!-- =================================================================== -->
    <!-- CLEARER RIVER ATMOSPHERE & LIGHT UNDERWATER FOG (REDUCED DUST)      -->
    <!-- Greatly reduced foggy dust so dirt particles & plastics are visible -->
    <!-- =================================================================== -->
    <scene>
      <ambient>0.28 0.23 0.16 1.0</ambient>
      <background>0.16 0.13 0.08 1.0</background>
      <grid>false</grid>
      <shadows>false</shadows>
      <!-- Real Subsea Mud & Silt River Turbidity: optical blur and haze within 4.8m -->
      <fog>
        <type>linear</type>
        <color>0.28 0.22 0.14 1.0</color>
        <density>0.42</density>
        <start>0.2</start>
        <end>4.8</end>
      </fog>
    </scene>

    <!-- Natural Sun Illumination filtering clearly through water -->
    <light type="directional" name="monsoon_sun">
      <cast_shadows>false</cast_shadows>
      <pose>50 0 40 0 0 0</pose>
      <diffuse>0.62 0.62 0.55 1.0</diffuse>
      <specular>0.25 0.25 0.20 1.0</specular>
      <direction>-0.3 0.1 -0.9</direction>
    </light>

    <!-- Clear Water Ambient Fill Light -->
    <light type="directional" name="muddy_water_fill">
      <cast_shadows>false</cast_shadows>
      <pose>30 0 10 0 0 0</pose>
      <diffuse>0.30 0.32 0.28 1.0</diffuse>
      <specular>0.05 0.05 0.04 1.0</specular>
      <direction>0.1 -0.1 -1.0</direction>
    </light>

    <!-- =================================================================== -->
    <!-- LARGE RIVER WATER SURFACE (130 m x 50 m at z = 0.0 m)               -->
    <!-- Note: Strictly NO dust, scum or smoke placed above water surface    -->
    <!-- =================================================================== -->
    <model name="river_water_surface">
      <static>true</static>
      <pose>55.0 0.0 0.0 0 0 0</pose>
      <link name="surface_link">
        <visual name="surface_visual">
          <geometry><box><size>130.0 50.0 0.01</size></box></geometry>
          <material>
            <ambient>0.26 0.22 0.12 0.70</ambient>
            <diffuse>0.30 0.25 0.14 0.70</diffuse>
            <specular>0.5 0.5 0.3 0.4</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- EXPANDED & UNEVEN ALLUVIAL RIVERBED (130 m x 48 m, depth 1.6m-5.8m) -->
    <!-- =================================================================== -->
    <!-- Main Sloping Riverbed Base -->
    <model name="large_riverbed_base">
      <static>true</static>
      <pose>55.0 0.0 -3.60 0 0.026 0</pose>
      <link name="bed_link">
        <visual name="bed_visual">
          <geometry><box><size>130.2 48.0 0.40</size></box></geometry>
          <material>
            <ambient>0.36 0.30 0.20 1.0</ambient>
            <diffuse>0.42 0.35 0.24 1.0</diffuse>
            <specular>0.03 0.03 0.03 1.0</specular>
          </material>
        </visual>
        <collision name="bed_col">
          <geometry><box><size>130.2 48.0 0.40</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Uneven Bathymetry Sandbar 1: Upstream Sand Shoal (x = 10.0 m) -->
    <model name="riverbed_sandbar_upstream">
      <static>true</static>
      <pose>10.0 -2.5 -2.10 0.05 0.03 0.2</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>14.0 16.0 0.85</size></box></geometry>
          <material><ambient>0.40 0.34 0.22 1</ambient><diffuse>0.46 0.38 0.26 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>14.0 16.0 0.85</size></box></geometry></collision>
      </link>
    </model>

    <!-- Uneven Bathymetry Sandbar 2: Midstream Sediment Ridge (x = 34.0 m) -->
    <model name="riverbed_sandbar_midstream">
      <static>true</static>
      <pose>34.0 3.2 -2.85 -0.04 0.02 -0.3</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>18.0 18.0 0.95</size></box></geometry>
          <material><ambient>0.38 0.32 0.21 1</ambient><diffuse>0.44 0.36 0.25 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>18.0 18.0 0.95</size></box></geometry></collision>
      </link>
    </model>

    <!-- Uneven Bathymetry Sandbar 3: Downstream Scour Dune (x = 75.0 m) -->
    <model name="riverbed_sandbar_downstream">
      <static>true</static>
      <pose>75.0 -4.0 -3.80 0.03 0.04 0.4</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>22.0 16.0 1.10</size></box></geometry>
          <material><ambient>0.35 0.29 0.19 1</ambient><diffuse>0.40 0.33 0.22 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>22.0 16.0 1.10</size></box></geometry></collision>
      </link>
    </model>

    <!-- Riverbed Uneven Terrace: Port Side Shoal (y = +15.0 m) -->
    <model name="riverbed_shoal_port">
      <static>true</static>
      <pose>50.0 16.0 -2.40 0.12 0.02 0.0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>90.0 12.0 0.70</size></box></geometry>
          <material><ambient>0.38 0.32 0.22 1</ambient><diffuse>0.44 0.37 0.26 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>90.0 12.0 0.70</size></box></geometry></collision>
      </link>
    </model>

    <!-- Riverbed Uneven Terrace: Starboard Side Shoal (y = -15.0 m) -->
    <model name="riverbed_shoal_stbd">
      <static>true</static>
      <pose>52.0 -16.0 -2.50 -0.12 0.02 0.0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>95.0 12.0 0.70</size></box></geometry>
          <material><ambient>0.38 0.32 0.22 1</ambient><diffuse>0.44 0.37 0.26 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>95.0 12.0 0.70</size></box></geometry></collision>
      </link>
    </model>

    <!-- Port River Embankment (Ghat / Rip-rap stone revetment, y = +25 m) -->
    <model name="bank_port_revetment">
      <static>true</static>
      <pose>55.0 25.5 -1.5 0.65 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>130.0 6.0 0.4</size></box></geometry>
          <material><ambient>0.35 0.32 0.26 1</ambient><diffuse>0.38 0.35 0.28 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>130.0 6.0 0.4</size></box></geometry></collision>
      </link>
    </model>

    <!-- Starboard River Bank (Alluvial earthen embankment, y = -25 m) -->
    <model name="bank_stbd_earthen">
      <static>true</static>
      <pose>55.0 -25.5 -1.5 -0.65 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>130.0 6.0 0.4</size></box></geometry>
          <material><ambient>0.36 0.30 0.22 1</ambient><diffuse>0.40 0.34 0.25 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>130.0 6.0 0.4</size></box></geometry></collision>
      </link>
    </model>

    <!-- Upstream River Boundary (x = -12.0 m) -->
    <model name="upstream_wall">
      <static>true</static>
      <pose>-12.0 0.0 -2.0 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.4 50.0 8.0</size></box></geometry>
        <material><ambient>0.28 0.24 0.16 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.4 50.0 8.0</size></box></geometry></collision>
      </link>
    </model>

    <!-- Downstream River Boundary (x = 120.0 m) -->
    <model name="downstream_wall">
      <static>true</static>
      <pose>120.0 0.0 -3.0 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.4 50.0 10.0</size></box></geometry>
        <material><ambient>0.28 0.24 0.16 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.4 50.0 10.0</size></box></geometry></collision>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- SUSPENDED SPHERICAL DIRT PARTICLES (PHYSICAL COLLISIONS INSIDE WATER)-->
    <!-- Thousands of continuous dirt specks + physical dirt particle spheres -->
    <!-- =================================================================== -->
        <!-- =================================================================== -->
    <!-- HIGH-THROUGHPUT CONTINUOUS DUST, MUD & SILT PARTICLE EMITTERS       -->
    <!-- Over 1,000,000,000 drifting micro-dirt particles strictly underwater-->
    <!-- and continuous riverbed mud kick-up clouds                          -->
    <!-- =================================================================== -->
    <model name="underwater_spherical_dust_emitter">
      <static>true</static>
      <pose>50.0 0.0 -1.65 0 0 0</pose>
      <link name="emitter_link">
        <particle_emitter name="water_dust_emitter" type="box">
          <emitting>true</emitting>
          <!-- Spans 100m length x 36m width x 2.2m height, strictly underwater -->
          <size>100.0 36.0 2.2</size>
          <particle_size>0.010 0.010 0.010</particle_size>
          <lifetime>25.0</lifetime>
          <rate>450</rate>
          <min_velocity>0.05</min_velocity>
          <max_velocity>0.28</max_velocity>
          <color_range_image/>
          <material>
            <diffuse>0.32 0.26 0.16 0.85</diffuse>
            <ambient>0.28 0.22 0.12 0.85</ambient>
          </material>
        </particle_emitter>
      </link>
    </model>

    <!-- Riverbed Mud & Silt Cloud Emitter (Kicking up clouds from the bottom) -->
    <model name="underwater_riverbed_mud_emitter">
      <static>true</static>
      <pose>45.0 0.0 -2.40 0 0 0</pose>
      <link name="bed_emitter_link">
        <particle_emitter name="riverbed_silt_emitter" type="box">
          <emitting>true</emitting>
          <size>90.0 24.0 1.2</size>
          <particle_size>0.014 0.014 0.014</particle_size>
          <lifetime>20.0</lifetime>
          <rate>380</rate>
          <min_velocity>0.02</min_velocity>
          <max_velocity>0.15</max_velocity>
          <material>
            <diffuse>0.26 0.18 0.10 0.90</diffuse>
            <ambient>0.22 0.15 0.08 0.90</ambient>
          </material>
        </particle_emitter>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- CAMERA SENSOR FOV DENSE MUD & SILT DRIFT EMITTER                    -->
    <!-- Positioned directly in front of ROV camera (4.0m to 10.0m downstream)-->
    <!-- =================================================================== -->
    <model name="camera_fov_mud_emitter">
      <static>true</static>
      <pose>6.8 0.0 -1.0 0 0 0</pose>
      <link name="cam_emitter_link">
        <particle_emitter name="camera_silt_emitter" type="box">
          <emitting>true</emitting>
          <size>8.0 4.2 2.2</size>
          <particle_size>0.035 0.035 0.035</particle_size>
          <lifetime>20.0</lifetime>
          <rate>850</rate>
          <min_velocity>0.02</min_velocity>
          <max_velocity>0.20</max_velocity>
          <material>
            <diffuse>0.30 0.22 0.13 0.95</diffuse>
            <ambient>0.26 0.18 0.10 0.95</ambient>
          </material>
        </particle_emitter>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- 60 CAMERA FOV FLOATING DYNAMIC MUD CLODS (WATER COLUMN AHEAD OF ROV)-->
    <!-- Visible directly from ROV camera: X in [4.3, 10.5], Y in [-1.6, 1.6] -->
    <!-- Neutrally buoyant (gravity:false, damping:0.85). Free to tumble!    -->
    <!-- =================================================================== -->
    <model name="cam_fov_mud_01">
      <static>true</static>
      <pose>8.25 -1.47 -1.22 -0.22 0.19 1.11</pose>
      <link name="l">
        <gravity>false</gravity>
        <velocity_decay><linear>0.85</linear><angular>0.85</angular></velocity_decay>
        <inertial>
          <mass>3.06</mass>
          <inertia><ixx>0.007257</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.007257</iyy><iyz>0</iyz><izz>0.007257</izz></inertia>
        </inertial>
        <collision name="c"><geometry><sphere><radius>0.077</radius></sphere></geometry></collision>
        <visual name="v"><geometry><sphere><radius>0.077</radius></sphere></geometry><material><ambient>0.19 0.15 0.06 1</ambient><diffuse>0.24 0.19 0.08 1</diffuse></material></visual>
      </link>
    </model>
