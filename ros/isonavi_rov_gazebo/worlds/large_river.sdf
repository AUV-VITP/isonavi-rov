      <link name="l">
        <visual name="v"><geometry><box><size>0.8 1.0 0.6</size></box></geometry><material><ambient>0.45 0.43 0.38 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.8 1.0 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- STRUCTURE 3: TWIN-COLUMN RAILWAY BRIDGE PIER 2 (x = 65.0 m)         -->
    <!-- =================================================================== -->
    <model name="bridge_pier_2_twin">
      <static>true</static>
      <pose>65.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <!-- Upstream Column (y = +3.5 m) -->
        <visual name="col_up">
          <pose>0 3.5 0 0 0 0</pose>
          <geometry><cylinder><radius>1.1</radius><length>9.0</length></cylinder></geometry>
          <material><ambient>0.50 0.48 0.44 1</ambient><diffuse>0.54 0.52 0.47 1</diffuse></material>
        </visual>
        <collision name="col_up_c"><pose>0 3.5 0 0 0 0</pose><geometry><cylinder><radius>1.1</radius><length>9.0</length></cylinder></geometry></collision>

        <!-- Downstream Column (y = -3.5 m) -->
        <visual name="col_down">
          <pose>0 -3.5 0 0 0 0</pose>
          <geometry><cylinder><radius>1.1</radius><length>9.0</length></cylinder></geometry>
          <material><ambient>0.50 0.48 0.44 1</ambient><diffuse>0.54 0.52 0.47 1</diffuse></material>
        </visual>
        <collision name="col_down_c"><pose>0 -3.5 0 0 0 0</pose><geometry><cylinder><radius>1.1</radius><length>9.0</length></cylinder></geometry></collision>

        <!-- Pier Cap Crossbeam (above water at z = +4.0 m) -->
        <visual name="crossbeam">
          <pose>0 0 4.2 0 0 0</pose>
          <geometry><box><size>2.6 10.0 1.2</size></box></geometry>
          <material><ambient>0.52 0.50 0.46 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- STRUCTURE 4: BARRAGE FLOOD CONTROL SLUICE WEIR (x = 95.0 m)         -->
    <!-- =================================================================== -->
    <model name="barrage_sluice_weir">
      <static>true</static>
      <pose>95.0 0.0 -1.5 0 0 0</pose>
      <link name="link">
        <!-- Main Concrete Weir Wall -->
        <visual name="weir_wall">
          <geometry><box><size>1.6 28.0 6.0</size></box></geometry>
          <material><ambient>0.48 0.46 0.42 1</ambient><diffuse>0.52 0.50 0.45 1</diffuse></material>
        </visual>
        <collision name="weir_c"><geometry><box><size>1.6 28.0 6.0</size></box></geometry></collision>

        <!-- Sluice Gate 1 Open Conduit Opening (y = -4.5 m) -->
        <visual name="gate_conduit_1">
          <pose>0 -4.5 -1.5 0 0 0</pose>
          <geometry><box><size>1.8 3.5 2.5</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient></material>
        </visual>

        <!-- Sluice Gate 2 Open Conduit Opening (y = 4.5 m) -->
        <visual name="gate_conduit_2">
          <pose>0 4.5 -1.5 0 0 0</pose>
          <geometry><box><size>1.8 3.5 2.5</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Tethered Navigation Marker Buoy 1 (Yellow, x = 16.0 m, y = -2.0 m) -->
    <model name="flood_warning_buoy_1">
      <static>true</static>
      <pose>16.0 -2.0 -0.7 0 0 0</pose>
      <link name="link">
        <visual name="s"><geometry><sphere><radius>0.20</radius></sphere></geometry><material><ambient>0.92 0.82 0.08 1</ambient><diffuse>0.92 0.82 0.08 1</diffuse></material></visual>
        <visual name="t"><pose>0 0 -0.8 0 0 0</pose><geometry><cylinder><radius>0.008</radius><length>1.6</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="c"><geometry><sphere><radius>0.20</radius></sphere></geometry></collision>
      </link>
    </model>

    <!-- Tethered Pipeline Hazard Buoy 2 (Red, x = 38.0 m, y = 2.5 m) -->
    <model name="flood_hazard_buoy_2">
      <static>true</static>
      <pose>38.0 2.5 -0.8 0 0 0</pose>
      <link name="link">
        <visual name="s"><geometry><sphere><radius>0.20</radius></sphere></geometry><material><ambient>0.90 0.10 0.08 1</ambient><diffuse>0.90 0.10 0.08 1</diffuse></material></visual>
        <visual name="t"><pose>0 0 -0.9 0 0 0</pose><geometry><cylinder><radius>0.008</radius><length>1.8</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="c"><geometry><sphere><radius>0.20</radius></sphere></geometry></collision>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- ROBOT MODEL: isonavi_rov SPAWNED IN LARGE RIVER                     -->
    <!-- Spawn pose: x = 4.0 m, y = 0.0 m, z = -1.0 m (Facing Downstream)    -->
    <!-- =================================================================== -->
    <include>
      <uri>model://isonavi_rov</uri>
      <name>isonavi_rov</name>
      <pose>4.0 0.0 -1.00 0 0 0</pose>
      <!-- Odometry Publisher Plugin -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/model/isonavi_rov/odometry</odom_topic>
        <robot_base_frame>isonavi_rov::base_link</robot_base_frame>
        <dimensions>3</dimensions>
      </plugin>
    </include>

  </world>
</sdf>
