<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="large_river">

    <!-- =================================================================== -->
    <!-- PHYSICS ENGINE CONFIGURATION                                        -->
    <!-- =================================================================== -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo Harmonic Simulation Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>

    <!-- Dynamic Particle Emitter System (Suspended Spherical Dust strictly INSIDE water) -->
    <plugin filename="gz-sim-particle-emitter-system" name="gz::sim::systems::ParticleEmitter"/>

    <!-- Buoyancy: High-density silty flood water (1005 kg/m^3 with suspended sediment) -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1005.0</default_density>
        <density_change>
          <above_depth>0.0</above_depth>
          <density>1.2</density>
        </density_change>
      </graded_buoyancy>
      <enable>isonavi_rov::base_link</enable>
    </plugin>

    <!-- =================================================================== -->
    <!-- TURBID MONSOON RIVER ATMOSPHERE & UNDERWATER FOG                    -->
    <!-- Simulates heavy flood sediment (up to 3.2 g/L) and low visibility   -->
    <!-- =================================================================== -->
    <scene>
      <ambient>0.24 0.20 0.12 1.0</ambient>
      <background>0.22 0.18 0.10 1.0</background>
      <grid>false</grid>
      <shadows>false</shadows>
      <!-- Muddy flood silt fog: optical visibility degrades between 0.4m and 3.8m -->
      <fog>
        <type>linear</type>
        <color>0.26 0.21 0.12 1.0</color>
        <density>0.55</density>
        <start>0.4</start>
        <end>3.8</end>
      </fog>
    </scene>

    <!-- Overcast Monsoon Sky Illumination -->
    <light type="directional" name="monsoon_sun">
      <cast_shadows>false</cast_shadows>
      <pose>50 0 40 0 0 0</pose>
      <diffuse>0.32 0.27 0.16 1.0</diffuse>
      <specular>0.05 0.05 0.02 1.0</specular>
      <direction>-0.3 0.1 -0.9</direction>
    </light>

    <!-- Muddy Water Backscatter Ambient Light -->
    <light type="directional" name="muddy_water_fill">
      <cast_shadows>false</cast_shadows>
      <pose>30 0 10 0 0 0</pose>
      <diffuse>0.22 0.18 0.11 1.0</diffuse>
      <specular>0.01 0.01 0.01 1.0</specular>
      <direction>0.1 -0.1 -1.0</direction>
    </light>

    <!-- =================================================================== -->
    <!-- LARGE RIVER WATER SURFACE (130 m x 50 m at z = 0.0 m)               -->
    <!-- Note: Strictly NO dust, scum or smoke placed above water surface    -->
    <!-- =================================================================== -->
    <model name="river_water_surface">
      <static>true</static>
      <pose>55.0 0.0 0.0 0 0 0</pose>
      <link name="surface_link">
        <visual name="surface_visual">
          <geometry><box><size>130.0 50.0 0.01</size></box></geometry>
          <material>
            <ambient>0.26 0.22 0.12 0.70</ambient>
            <diffuse>0.30 0.25 0.14 0.70</diffuse>
            <specular>0.5 0.5 0.3 0.4</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- EXPANDED & UNEVEN ALLUVIAL RIVERBED (130 m x 48 m, depth 1.6m-5.8m) -->
    <!-- =================================================================== -->
    <!-- Main Sloping Riverbed Base -->
    <model name="large_riverbed_base">
      <static>true</static>
      <pose>55.0 0.0 -3.60 0 0.026 0</pose>
      <link name="bed_link">
        <visual name="bed_visual">
          <geometry><box><size>130.2 48.0 0.40</size></box></geometry>
          <material>
            <ambient>0.36 0.30 0.20 1.0</ambient>
            <diffuse>0.42 0.35 0.24 1.0</diffuse>
            <specular>0.03 0.03 0.03 1.0</specular>
          </material>
        </visual>
        <collision name="bed_col">
          <geometry><box><size>130.2 48.0 0.40</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Uneven Bathymetry Sandbar 1: Upstream Sand Shoal (x = 10.0 m) -->
    <model name="riverbed_sandbar_upstream">
      <static>true</static>
      <pose>10.0 -2.5 -2.10 0.05 0.03 0.2</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>14.0 16.0 0.85</size></box></geometry>
          <material><ambient>0.40 0.34 0.22 1</ambient><diffuse>0.46 0.38 0.26 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>14.0 16.0 0.85</size></box></geometry></collision>
      </link>
    </model>

    <!-- Uneven Bathymetry Sandbar 2: Midstream Sediment Ridge (x = 34.0 m) -->
    <model name="riverbed_sandbar_midstream">
      <static>true</static>
      <pose>34.0 3.2 -2.85 -0.04 0.02 -0.3</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>18.0 18.0 0.95</size></box></geometry>
          <material><ambient>0.38 0.32 0.21 1</ambient><diffuse>0.44 0.36 0.25 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>18.0 18.0 0.95</size></box></geometry></collision>
      </link>
    </model>

    <!-- Uneven Bathymetry Sandbar 3: Downstream Scour Dune (x = 75.0 m) -->
    <model name="riverbed_sandbar_downstream">
      <static>true</static>
      <pose>75.0 -4.0 -3.80 0.03 0.04 0.4</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>22.0 16.0 1.10</size></box></geometry>
          <material><ambient>0.35 0.29 0.19 1</ambient><diffuse>0.40 0.33 0.22 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>22.0 16.0 1.10</size></box></geometry></collision>
      </link>
    </model>

    <!-- Riverbed Uneven Terrace: Port Side Shoal (y = +15.0 m) -->
    <model name="riverbed_shoal_port">
      <static>true</static>
      <pose>50.0 16.0 -2.40 0.12 0.02 0.0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>90.0 12.0 0.70</size></box></geometry>
          <material><ambient>0.38 0.32 0.22 1</ambient><diffuse>0.44 0.37 0.26 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>90.0 12.0 0.70</size></box></geometry></collision>
      </link>
    </model>

    <!-- Riverbed Uneven Terrace: Starboard Side Shoal (y = -15.0 m) -->
    <model name="riverbed_shoal_stbd">
      <static>true</static>
      <pose>52.0 -16.0 -2.50 -0.12 0.02 0.0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>95.0 12.0 0.70</size></box></geometry>
          <material><ambient>0.38 0.32 0.22 1</ambient><diffuse>0.44 0.37 0.26 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>95.0 12.0 0.70</size></box></geometry></collision>
      </link>
    </model>

    <!-- Port River Embankment (Ghat / Rip-rap stone revetment, y = +25 m) -->
    <model name="bank_port_revetment">
      <static>true</static>
      <pose>55.0 25.5 -1.5 0.65 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>130.0 6.0 0.4</size></box></geometry>
          <material><ambient>0.35 0.32 0.26 1</ambient><diffuse>0.38 0.35 0.28 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>130.0 6.0 0.4</size></box></geometry></collision>
      </link>
    </model>

    <!-- Starboard River Bank (Alluvial earthen embankment, y = -25 m) -->
    <model name="bank_stbd_earthen">
      <static>true</static>
      <pose>55.0 -25.5 -1.5 -0.65 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>130.0 6.0 0.4</size></box></geometry>
          <material><ambient>0.36 0.30 0.22 1</ambient><diffuse>0.40 0.34 0.25 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>130.0 6.0 0.4</size></box></geometry></collision>
      </link>
    </model>

    <!-- Upstream River Boundary (x = -12.0 m) -->
    <model name="upstream_wall">
      <static>true</static>
      <pose>-12.0 0.0 -2.0 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.4 50.0 8.0</size></box></geometry>
        <material><ambient>0.28 0.24 0.16 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.4 50.0 8.0</size></box></geometry></collision>
      </link>
    </model>

    <!-- Downstream River Boundary (x = 120.0 m) -->
    <model name="downstream_wall">
      <static>true</static>
      <pose>120.0 0.0 -3.0 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.4 50.0 10.0</size></box></geometry>
        <material><ambient>0.28 0.24 0.16 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.4 50.0 10.0</size></box></geometry></collision>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- SUSPENDED SPHERICAL DUST PARTICLES (FLOATING STRICTLY INSIDE WATER) -->
    <!-- Small spherical dust particles drifting at various water depths     -->
    <!-- =================================================================== -->
    <!-- Dynamic Box Emitter generating tiny suspended spherical dust inside water (z = -1.6m) -->
    <model name="underwater_spherical_dust_emitter">
      <static>true</static>
      <pose>50.0 0.0 -1.65 0 0 0</pose>
      <link name="emitter_link">
        <particle_emitter name="water_dust_emitter" type="box">
          <emitting>true</emitting>
          <!-- Spans 100m length x 36m width x 2.2m height, strictly underwater -->
          <size>100.0 36.0 2.2</size>
          <particle_size>0.022 0.022 0.022</particle_size>
          <lifetime>18.0</lifetime>
          <min_velocity>0.01</min_velocity>
          <max_velocity>0.06</max_velocity>
          <scale_rate>0.15</scale_rate>
          <rate>110</rate>
          <material>
            <ambient>0.62 0.56 0.42 0.70</ambient>
            <diffuse>0.62 0.56 0.42 0.70</diffuse>
            <specular>0.1 0.1 0.1 0.4</specular>
          </material>
        </particle_emitter>
      </link>
    </model>

    <!-- Floating Spherical Dust Cluster 1: Upstream (x = 5.5 m, z = -0.75 m) -->
    <model name="dust_sphere_cluster_1">
      <static>true</static>
      <pose>5.5 -0.8 -0.75 0 0 0</pose>
      <link name="link">
        <visual name="s1"><geometry><sphere><radius>0.025</radius></sphere></geometry><material><ambient>0.65 0.58 0.44 0.8</ambient><diffuse>0.65 0.58 0.44 0.8</diffuse></material></visual>
        <visual name="s2"><pose>0.12 0.08 -0.05 0 0 0</pose><geometry><sphere><radius>0.018</radius></sphere></geometry><material><ambient>0.60 0.54 0.40 0.75</ambient></material></visual>
        <visual name="s3"><pose>-0.09 -0.14 0.06 0 0 0</pose><geometry><sphere><radius>0.022</radius></sphere></geometry><material><ambient>0.62 0.56 0.42 0.8</ambient></material></visual>
        <visual name="s4"><pose>0.18 -0.06 0.08 0 0 0</pose><geometry><sphere><radius>0.015</radius></sphere></geometry><material><ambient>0.60 0.52 0.38 0.7</ambient></material></visual>
        <visual name="s5"><pose>-0.15 0.12 -0.08 0 0 0</pose><geometry><sphere><radius>0.028</radius></sphere></geometry><material><ambient>0.64 0.58 0.44 0.85</ambient></material></visual>
      </link>
    </model>

    <!-- Floating Spherical Dust Cluster 2: Near Bridge Pier 1 (x = 18.5 m, z = -1.20 m) -->
    <model name="dust_sphere_cluster_2">
      <static>true</static>
      <pose>18.5 1.2 -1.20 0 0 0</pose>
      <link name="link">
        <visual name="s1"><geometry><sphere><radius>0.030</radius></sphere></geometry><material><ambient>0.62 0.55 0.40 0.8</ambient></material></visual>
        <visual name="s2"><pose>0.15 -0.10 0.05 0 0 0</pose><geometry><sphere><radius>0.020</radius></sphere></geometry><material><ambient>0.60 0.52 0.38 0.75</ambient></material></visual>
        <visual name="s3"><pose>-0.12 0.16 -0.07 0 0 0</pose><geometry><sphere><radius>0.025</radius></sphere></geometry><material><ambient>0.64 0.56 0.42 0.8</ambient></material></visual>
        <visual name="s4"><pose>0.08 0.14 0.10 0 0 0</pose><geometry><sphere><radius>0.016</radius></sphere></geometry><material><ambient>0.58 0.50 0.36 0.7</ambient></material></visual>
        <visual name="s5"><pose>-0.18 -0.08 0.03 0 0 0</pose><geometry><sphere><radius>0.026</radius></sphere></geometry><material><ambient>0.65 0.58 0.44 0.85</ambient></material></visual>
      </link>
    </model>

    <!-- Floating Spherical Dust Cluster 3: Near Submerged Pipeline (x = 38.0 m, z = -1.85 m) -->
    <model name="dust_sphere_cluster_3">
      <static>true</static>
      <pose>38.0 -1.5 -1.85 0 0 0</pose>
      <link name="link">
        <visual name="s1"><geometry><sphere><radius>0.032</radius></sphere></geometry><material><ambient>0.60 0.52 0.38 0.8</ambient></material></visual>
        <visual name="s2"><pose>-0.14 0.12 0.08 0 0 0</pose><geometry><sphere><radius>0.024</radius></sphere></geometry><material><ambient>0.62 0.54 0.40 0.75</ambient></material></visual>
        <visual name="s3"><pose>0.16 -0.15 -0.06 0 0 0</pose><geometry><sphere><radius>0.020</radius></sphere></geometry><material><ambient>0.58 0.50 0.36 0.7</ambient></material></visual>
        <visual name="s4"><pose>-0.08 -0.16 0.12 0 0 0</pose><geometry><sphere><radius>0.028</radius></sphere></geometry><material><ambient>0.64 0.56 0.42 0.85</ambient></material></visual>
      </link>
    </model>

    <!-- Floating Spherical Dust Cluster 4: Deep Sluice Approach (x = 82.0 m, z = -2.40 m) -->
    <model name="dust_sphere_cluster_4">
      <static>true</static>
      <pose>82.0 0.8 -2.40 0 0 0</pose>
      <link name="link">
        <visual name="s1"><geometry><sphere><radius>0.035</radius></sphere></geometry><material><ambient>0.58 0.50 0.36 0.8</ambient></material></visual>
        <visual name="s2"><pose>0.18 0.14 -0.09 0 0 0</pose><geometry><sphere><radius>0.022</radius></sphere></geometry><material><ambient>0.60 0.52 0.38 0.75</ambient></material></visual>
        <visual name="s3"><pose>-0.15 -0.12 0.08 0 0 0</pose><geometry><sphere><radius>0.028</radius></sphere></geometry><material><ambient>0.62 0.54 0.40 0.8</ambient></material></visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- ROCKS & BOULDERS (WITH FULL COLLISION PHYSICS)                       -->
    <!-- Massive riverbed boulders, jagged scour rocks, and rocky outcrops   -->
    <!-- =================================================================== -->
    <!-- Upstream Jagged Rock Outcrop (x = 7.5 m, y = -3.2 m) -->
    <model name="rock_outcrop_upstream">
      <static>true</static>
      <pose>7.5 -3.2 -1.65 0.15 0.25 0.6</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>1.85 1.45 1.10</size></box></geometry>
          <material><ambient>0.30 0.28 0.24 1</ambient><diffuse>0.36 0.33 0.28 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>1.85 1.45 1.10</size></box></geometry></collision>
      </link>
    </model>

    <!-- Granite Rock Field Near Start (x = 11.2 m, y = 2.8 m) -->
    <model name="granite_rock_1">
      <static>true</static>
      <pose>11.2 2.8 -1.80 -0.2 0.15 1.2</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>1.60 1.25 0.95</size></box></geometry>
          <material><ambient>0.32 0.30 0.26 1</ambient><diffuse>0.38 0.35 0.30 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>1.60 1.25 0.95</size></box></geometry></collision>
      </link>
    </model>

    <!-- Scour Boulder Deflector at Bridge Pier 1 (x = 20.0 m, y = -1.8 m) -->
    <model name="boulder_pier_1_deflector">
      <static>true</static>
      <pose>20.0 -1.8 -2.40 0.1 0.3 0.4</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>2.20 1.70 1.35</size></box></geometry>
          <material><ambient>0.26 0.25 0.22 1</ambient><diffuse>0.32 0.30 0.26 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>2.20 1.70 1.35</size></box></geometry></collision>
      </link>
    </model>

    <!-- Boulder Field 1 (x = 28.0 m to 32.0 m) -->
    <model name="boulder_field_1">
      <static>true</static>
      <pose>28.0 -2.5 -2.85 0.2 0.3 0.5</pose>
      <link name="l">
        <visual name="v"><geometry><box><size>1.90 1.50 1.20</size></box></geometry><material><ambient>0.32 0.30 0.26 1</ambient><diffuse>0.38 0.35 0.30 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.90 1.50 1.20</size></box></geometry></collision>
      </link>
    </model>

    <model name="boulder_field_2">
      <static>true</static>
      <pose>30.5 1.8 -2.95 -0.1 0.4 1.1</pose>
      <link name="l">
        <visual name="v"><geometry><box><size>1.60 1.40 1.05</size></box></geometry><material><ambient>0.30 0.28 0.25 1</ambient><diffuse>0.36 0.34 0.29 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.60 1.40 1.05</size></box></geometry></collision>
      </link>
    </model>

    <!-- Submerged Rocky Shelf (x = 36.5 m, y = -3.8 m) -->
    <model name="submerged_rock_shelf">
      <static>true</static>
      <pose>36.5 -3.8 -2.90 0.2 0.1 0.8</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>2.80 2.10 0.90</size></box></geometry>
          <material><ambient>0.28 0.27 0.23 1</ambient><diffuse>0.34 0.32 0.27 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>2.80 2.10 0.90</size></box></geometry></collision>
      </link>
    </model>

    <!-- Jagged Bedrock Spire Hazard (x = 48.0 m, y = 2.2 m) -->
    <model name="sharp_bedrock_spire">
      <static>true</static>
      <pose>48.0 2.2 -2.60 0.3 0.2 1.4</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>1.70 1.30 1.40</size></box></geometry>
          <material><ambient>0.26 0.25 0.22 1</ambient><diffuse>0.32 0.30 0.26 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>1.70 1.30 1.40</size></box></geometry></collision>
      </link>
    </model>

    <!-- Railway Bridge Pier 2 Boulder Anchor (x = 63.0 m, y = -1.2 m) -->
    <model name="boulder_pier_2_anchor">
      <static>true</static>
      <pose>63.0 -1.2 -3.10 -0.15 0.25 0.5</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>2.50 1.80 1.40</size></box></geometry>
          <material><ambient>0.28 0.27 0.24 1</ambient><diffuse>0.34 0.32 0.28 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>2.50 1.80 1.40</size></box></geometry></collision>
      </link>
    </model>

    <!-- Downstream Deep Rock Mound (x = 78.0 m, y = 3.5 m) -->
    <model name="downstream_rock_mound">
      <static>true</static>
      <pose>78.0 3.5 -3.40 0.25 0.1 0.9</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>2.40 1.90 1.30</size></box></geometry>
          <material><ambient>0.30 0.29 0.25 1</ambient><diffuse>0.36 0.34 0.29 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>2.40 1.90 1.30</size></box></geometry></collision>
      </link>
    </model>

    <!-- Weir Approach Scour Dissipator Boulders (x = 88.0 m) -->
    <model name="weir_dissipator_rock_1">
      <static>true</static>
      <pose>88.0 -2.5 -3.20 0.1 0.2 0.3</pose>
      <link name="l">
        <visual name="v"><geometry><box><size>1.80 1.50 1.20</size></box></geometry><material><ambient>0.28 0.26 0.22 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>1.80 1.50 1.20</size></box></geometry></collision>
      </link>
    </model>
    <model name="weir_dissipator_rock_2">
      <static>true</static>
      <pose>88.0 2.5 -3.20 -0.1 0.2 -0.3</pose>
      <link name="l">
        <visual name="v"><geometry><box><size>1.80 1.50 1.20</size></box></geometry><material><ambient>0.28 0.26 0.22 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>1.80 1.50 1.20</size></box></geometry></collision>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- ROTTEN WOODEN ITEMS (WITH FULL COLLISION PHYSICS)                   -->
    <!-- Rotting driftwood trunks, logs, broken wooden pallets, tree roots   -->
    <!-- =================================================================== -->
    <!-- Rotten Driftwood Tree Trunk 1 (x = 14.0 m, y = 2.5 m) -->
    <model name="rotten_driftwood_trunk_1">
      <static>true</static>
      <pose>14.0 2.5 -1.95 0.1 0.25 0.8</pose>
      <link name="l">
        <visual name="trunk">
          <geometry><cylinder><radius>0.32</radius><length>7.5</length></cylinder></geometry>
          <material>
            <!-- Decaying dark rotten bark -->
            <ambient>0.24 0.16 0.10 1.0</ambient>
            <diffuse>0.28 0.19 0.12 1.0</diffuse>
            <specular>0.02 0.02 0.02 1.0</specular>
          </material>
        </visual>
        <collision name="trunk_c"><geometry><cylinder><radius>0.32</radius><length>7.5</length></cylinder></geometry></collision>
        <!-- Rotten Branch Stub 1 -->
