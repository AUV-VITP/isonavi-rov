<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="large_river">

    <!-- =================================================================== -->
    <!-- PHYSICS ENGINE CONFIGURATION                                        -->
    <!-- =================================================================== -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo Harmonic Simulation Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>

    <!-- Buoyancy: High-density silty flood water (1005 kg/m^3 with suspended sediment) -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1005.0</default_density>
        <density_change>
          <above_depth>0.0</above_depth>
          <density>1.2</density>
        </density_change>
      </graded_buoyancy>
      <enable>isonavi_rov::base_link</enable>
    </plugin>

    <!-- =================================================================== -->
    <!-- TURBID MONSOON RIVER ATMOSPHERE & FOG                               -->
    <!-- Simulates heavy flood sediment (up to 3.2 g/L) and low visibility   -->
    <!-- =================================================================== -->
    <scene>
      <ambient>0.24 0.20 0.12 1.0</ambient>
      <background>0.22 0.18 0.10 1.0</background>
      <grid>false</grid>
      <shadows>false</shadows>
      <!-- Muddy flood silt fog: optical visibility degrades between 0.4m and 3.5m -->
      <fog>
        <type>linear</type>
        <color>0.26 0.21 0.12 1.0</color>
        <density>0.55</density>
        <start>0.4</start>
        <end>3.5</end>
      </fog>
    </scene>

    <!-- Overcast Monsoon Sky Illumination -->
    <light type="directional" name="monsoon_sun">
      <cast_shadows>false</cast_shadows>
      <pose>50 0 40 0 0 0</pose>
      <diffuse>0.32 0.27 0.16 1.0</diffuse>
      <specular>0.05 0.05 0.02 1.0</specular>
      <direction>-0.3 0.1 -0.9</direction>
    </light>

    <!-- Muddy Water Backscatter Ambient Light -->
    <light type="directional" name="muddy_water_fill">
      <cast_shadows>false</cast_shadows>
      <pose>30 0 10 0 0 0</pose>
      <diffuse>0.22 0.18 0.11 1.0</diffuse>
      <specular>0.01 0.01 0.01 1.0</specular>
      <direction>0.1 -0.1 -1.0</direction>
    </light>

    <!-- =================================================================== -->
    <!-- LARGE RIVER WATER SURFACE (120 m x 46 m at z = 0.0 m)               -->
    <!-- =================================================================== -->
    <model name="river_water_surface">
      <static>true</static>
      <pose>50.0 0.0 0.0 0 0 0</pose>
      <link name="surface_link">
        <visual name="surface_visual">
          <geometry><box><size>120.0 46.0 0.01</size></box></geometry>
          <material>
            <ambient>0.26 0.22 0.12 0.70</ambient>
            <diffuse>0.30 0.25 0.14 0.70</diffuse>
            <specular>0.5 0.5 0.3 0.4</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- EXPANDED RIVERBED (120 m x 44 m, depth sloping 1.8 m to 5.5 m)      -->
    <!-- =================================================================== -->
    <model name="large_riverbed">
      <static>true</static>
      <pose>50.0 0.0 -3.40 0 0.028 0</pose>
      <link name="bed_link">
        <visual name="bed_visual">
          <geometry><box><size>120.2 44.0 0.30</size></box></geometry>
          <material>
            <ambient>0.38 0.32 0.22 1.0</ambient>
            <diffuse>0.42 0.36 0.25 1.0</diffuse>
            <specular>0.04 0.04 0.04 1.0</specular>
          </material>
        </visual>
        <collision name="bed_col">
          <geometry><box><size>120.2 44.0 0.30</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Port River Embankment (Ghat / Rip-rap stone revetment, y = +22 m) -->
    <model name="bank_port_revetment">
      <static>true</static>
      <pose>50.0 23.5 -1.5 0.65 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>120.0 6.0 0.4</size></box></geometry>
          <material><ambient>0.35 0.32 0.26 1</ambient><diffuse>0.38 0.35 0.28 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>120.0 6.0 0.4</size></box></geometry></collision>
      </link>
    </model>

    <!-- Starboard River Bank (Alluvial earthen embankment, y = -22 m) -->
    <model name="bank_stbd_earthen">
      <static>true</static>
      <pose>50.0 -23.5 -1.5 -0.65 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>120.0 6.0 0.4</size></box></geometry>
          <material><ambient>0.36 0.30 0.22 1</ambient><diffuse>0.40 0.34 0.25 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>120.0 6.0 0.4</size></box></geometry></collision>
      </link>
    </model>

    <!-- Upstream River Boundary (x = -10.0 m) -->
    <model name="upstream_wall">
      <static>true</static>
      <pose>-10.0 0.0 -2.0 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.3 46.0 8.0</size></box></geometry>
        <material><ambient>0.28 0.24 0.16 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.3 46.0 8.0</size></box></geometry></collision>
      </link>
    </model>

    <!-- Downstream River Boundary (x = 110.0 m) -->
    <model name="downstream_wall">
      <static>true</static>
      <pose>110.0 0.0 -3.0 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.3 46.0 10.0</size></box></geometry>
        <material><ambient>0.28 0.24 0.16 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.3 46.0 10.0</size></box></geometry></collision>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- STRUCTURE 1: MAJOR ROAD BRIDGE PIER 1 (x = 22.0 m, y = 0.0 m)       -->
    <!-- =================================================================== -->
    <model name="bridge_pier_1">
      <static>true</static>
      <pose>22.0 0.0 0.8 0 0 0</pose>
      <link name="link">
        <!-- Main Concrete Column (radius 1.2m, height 8.0m) -->
        <visual name="column">
          <geometry><cylinder><radius>1.20</radius><length>8.0</length></cylinder></geometry>
          <material>
            <ambient>0.50 0.48 0.44 1.0</ambient>
            <diffuse>0.54 0.52 0.47 1.0</diffuse>
            <specular>0.1 0.1 0.1 1.0</specular>
          </material>
        </visual>
        <collision name="column_col">
          <geometry><cylinder><radius>1.20</radius><length>8.0</length></cylinder></geometry>
        </collision>

        <!-- Deep Scour Well Foundation Base at Riverbed (z = -3.2m) -->
        <visual name="scour_caisson">
          <pose>0 0 -3.2 0 0 0</pose>
          <geometry><cylinder><radius>1.85</radius><length>0.80</length></cylinder></geometry>
          <material><ambient>0.42 0.40 0.36 1.0</ambient><diffuse>0.45 0.43 0.38 1.0</diffuse></material>
        </visual>
        <collision name="caisson_col">
          <pose>0 0 -3.2 0 0 0</pose>
          <geometry><cylinder><radius>1.85</radius><length>0.80</length></cylinder></geometry>
        </collision>

        <!-- Waterline Silt / Flood Mark Ring (z = +0.2 m) -->
        <visual name="flood_waterline">
          <pose>0 0 0.2 0 0 0</pose>
          <geometry><cylinder><radius>1.22</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.32 0.26 0.16 1.0</ambient><diffuse>0.35 0.28 0.18 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- STRUCTURE 2: SUBMERGED RIVER CROSSING PIPELINE (x = 42.0 m)         -->
    <!-- Spans 32 m across riverbed with concrete anchor saddles             -->
    <!-- =================================================================== -->
    <model name="river_crossing_pipeline">
      <static>true</static>
      <pose>42.0 0.0 -3.6 1.5707963 0 0</pose>
      <link name="pipe_link">
        <visual name="pipe_v">
          <geometry><cylinder><radius>0.30</radius><length>32.0</length></cylinder></geometry>
          <material>
            <ambient>0.28 0.32 0.35 1.0</ambient>
            <diffuse>0.32 0.36 0.38 1.0</diffuse>
            <specular>0.3 0.3 0.35 1.0</specular>
          </material>
        </visual>
        <collision name="pipe_c">
          <geometry><cylinder><radius>0.30</radius><length>32.0</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- Pipeline Saddle 1 (y = -8.0 m) -->
    <model name="pipe_saddle_1">
      <static>true</static>
      <pose>42.0 -8.0 -3.8 0 0 0</pose>
      <link name="l">
        <visual name="v"><geometry><box><size>0.8 1.0 0.6</size></box></geometry><material><ambient>0.45 0.43 0.38 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.8 1.0 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- Pipeline Saddle 2 (y = 8.0 m) -->
    <model name="pipe_saddle_2">
      <static>true</static>
      <pose>42.0 8.0 -3.8 0 0 0</pose>
      <link name="l">
        <visual name="v"><geometry><box><size>0.8 1.0 0.6</size></box></geometry><material><ambient>0.45 0.43 0.38 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.8 1.0 0.6</size></box></geometry></collision>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- STRUCTURE 3: TWIN-COLUMN RAILWAY BRIDGE PIER 2 (x = 65.0 m)         -->
    <!-- =================================================================== -->
    <model name="bridge_pier_2_twin">
      <static>true</static>
      <pose>65.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <!-- Upstream Column (y = +3.5 m) -->
        <visual name="col_up">
          <pose>0 3.5 0 0 0 0</pose>
          <geometry><cylinder><radius>1.1</radius><length>9.0</length></cylinder></geometry>
          <material><ambient>0.50 0.48 0.44 1</ambient><diffuse>0.54 0.52 0.47 1</diffuse></material>
        </visual>
        <collision name="col_up_c"><pose>0 3.5 0 0 0 0</pose><geometry><cylinder><radius>1.1</radius><length>9.0</length></cylinder></geometry></collision>

        <!-- Downstream Column (y = -3.5 m) -->
        <visual name="col_down">
          <pose>0 -3.5 0 0 0 0</pose>
          <geometry><cylinder><radius>1.1</radius><length>9.0</length></cylinder></geometry>
          <material><ambient>0.50 0.48 0.44 1</ambient><diffuse>0.54 0.52 0.47 1</diffuse></material>
        </visual>
        <collision name="col_down_c"><pose>0 -3.5 0 0 0 0</pose><geometry><cylinder><radius>1.1</radius><length>9.0</length></cylinder></geometry></collision>

        <!-- Pier Cap Crossbeam (above water at z = +4.0 m) -->
        <visual name="crossbeam">
          <pose>0 0 4.2 0 0 0</pose>
          <geometry><box><size>2.6 10.0 1.2</size></box></geometry>
          <material><ambient>0.52 0.50 0.46 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- STRUCTURE 4: BARRAGE FLOOD CONTROL SLUICE WEIR (x = 92.0 m)         -->
    <!-- =================================================================== -->
    <model name="barrage_sluice_weir">
      <static>true</static>
      <pose>92.0 0.0 -1.5 0 0 0</pose>
      <link name="link">
        <!-- Main Concrete Weir Wall -->
        <visual name="weir_wall">
          <geometry><box><size>1.5 24.0 6.0</size></box></geometry>
          <material><ambient>0.48 0.46 0.42 1</ambient><diffuse>0.52 0.50 0.45 1</diffuse></material>
        </visual>
        <collision name="weir_c"><geometry><box><size>1.5 24.0 6.0</size></box></geometry></collision>

        <!-- Sluice Gate 1 Open Conduit Opening (y = -4.0 m) -->
        <visual name="gate_conduit_1">
          <pose>0 -4.0 -1.5 0 0 0</pose>
          <geometry><box><size>1.6 3.0 2.5</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient></material>
        </visual>

        <!-- Sluice Gate 2 Open Conduit Opening (y = 4.0 m) -->
        <visual name="gate_conduit_2">
          <pose>0 4.0 -1.5 0 0 0</pose>
          <geometry><box><size>1.6 3.0 2.5</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- RIVERBED DEBRIS & HAZARDS                                           -->
    <!-- =================================================================== -->
    <!-- Sunken Large Driftwood Tree (x = 12.0 m, y = 3.0 m) -->
    <model name="driftwood_tree">
      <static>true</static>
      <pose>12.0 3.0 -2.6 0.1 0.25 0.8</pose>
      <link name="l">
        <visual name="trunk">
          <geometry><cylinder><radius>0.28</radius><length>6.5</length></cylinder></geometry>
          <material><ambient>0.26 0.18 0.12 1</ambient><diffuse>0.30 0.20 0.14 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.28</radius><length>6.5</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Riverbed Scour Boulder Field (x = 28.0 m to 32.0 m) -->
    <model name="boulder_field_1">
      <static>true</static>
      <pose>28.0 -2.5 -3.3 0.2 0.3 0.5</pose>
      <link name="l"><visual name="v"><geometry><box><size>1.4 1.2 0.9</size></box></geometry><material><ambient>0.32 0.30 0.26 1</ambient></material></visual>
      <collision name="c"><geometry><box><size>1.4 1.2 0.9</size></box></geometry></collision></link>
    </model>

    <model name="boulder_field_2">
      <static>true</static>
      <pose>30.5 1.8 -3.4 -0.1 0.4 1.1</pose>
      <link name="l"><visual name="v"><geometry><box><size>1.1 1.0 0.7</size></box></geometry><material><ambient>0.32 0.30 0.26 1</ambient></material></visual>
      <collision name="c"><geometry><box><size>1.1 1.0 0.7</size></box></geometry></collision></link>
    </model>

    <!-- Tethered Navigation Marker Buoy 1 (Yellow, x = 16.0 m, y = -2.0 m) -->
    <model name="flood_warning_buoy_1">
      <static>true</static>
      <pose>16.0 -2.0 -0.7 0 0 0</pose>
      <link name="link">
        <visual name="s"><geometry><sphere><radius>0.20</radius></sphere></geometry><material><ambient>0.92 0.82 0.08 1</ambient><diffuse>0.92 0.82 0.08 1</diffuse></material></visual>
        <visual name="t"><pose>0 0 -0.8 0 0 0</pose><geometry><cylinder><radius>0.008</radius><length>1.6</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="c"><geometry><sphere><radius>0.20</radius></sphere></geometry></collision>
      </link>
    </model>

    <!-- Tethered Pipeline Hazard Buoy 2 (Red, x = 38.0 m, y = 2.5 m) -->
    <model name="flood_hazard_buoy_2">
      <static>true</static>
      <pose>38.0 2.5 -0.8 0 0 0</pose>
      <link name="link">
        <visual name="s"><geometry><sphere><radius>0.20</radius></sphere></geometry><material><ambient>0.90 0.10 0.08 1</ambient><diffuse>0.90 0.10 0.08 1</diffuse></material></visual>
        <visual name="t"><pose>0 0 -0.9 0 0 0</pose><geometry><cylinder><radius>0.008</radius><length>1.8</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="c"><geometry><sphere><radius>0.20</radius></sphere></geometry></collision>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- SUSPENDED SILT PLUMES (Muddy Flood Suspended Sediments)             -->
    <!-- =================================================================== -->
    <model name="flood_silt_plume_1">
      <static>true</static>
      <pose>18.0 0.0 -1.4 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>8.0 20.0 2.8</size></box></geometry>
          <material>
            <ambient>0.30 0.24 0.14 0.45</ambient>
            <diffuse>0.30 0.24 0.14 0.45</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="flood_silt_plume_2">
      <static>true</static>
      <pose>52.0 0.0 -1.8 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>12.0 24.0 3.2</size></box></geometry>
          <material>
            <ambient>0.32 0.26 0.15 0.50</ambient>
            <diffuse>0.32 0.26 0.15 0.50</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- ROBOT MODEL: isonavi_rov SPAWNED IN LARGE RIVER                     -->
    <!-- Spawn pose: x = 4.0 m, y = 0.0 m, z = -1.0 m (Facing Downstream)    -->
    <!-- =================================================================== -->
    <include>
      <uri>model://isonavi_rov</uri>
      <name>isonavi_rov</name>
      <pose>4.0 0.0 -1.00 0 0 0</pose>
      <!-- Odometry Publisher Plugin -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/model/isonavi_rov/odometry</odom_topic>
        <robot_base_frame>isonavi_rov::base_link</robot_base_frame>
        <dimensions>3</dimensions>
      </plugin>
    </include>

  </world>
</sdf>
