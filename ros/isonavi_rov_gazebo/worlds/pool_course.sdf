    <!-- =================================================================== -->
    <!-- ROBOT VEHICLE INCLUSION                                             -->
    <!-- =================================================================== -->
    <include>
      <uri>model://isonavi_rov</uri>
      <name>isonavi_rov</name>
      <pose>1.2 0 -0.25 0 0 0</pose>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/model/isonavi_rov/odometry</odom_topic>
        <robot_base_frame>isonavi_rov::base_link</robot_base_frame>
        <dimensions>3</dimensions>
      </plugin>
    </include>
  </world>
</sdf>
