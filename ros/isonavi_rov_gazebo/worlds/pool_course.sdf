<?xml version="1.0"?>
<sdf version="1.11">
  <world name="pool_course">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo Harmonic Simulation Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- Dynamic Particle Emitter System (Suspended Dust, Silt & Marine Snow) -->
    <plugin filename="gz-sim-particle-emitter-system" name="gz::sim::systems::ParticleEmitter"/>

    <!-- Graded Buoyancy: Freshwater 1000 kg/m^3 below surface, Air 1.2 kg/m^3 above -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000.0</default_density>
        <density_change>
          <above_depth>0.0</above_depth>
          <density>1.2</density>
        </density_change>
      </graded_buoyancy>
      <enable>isonavi_rov</enable>
    </plugin>

    <!-- =================================================================== -->
    <!-- UNDERWATER ATMOSPHERE & SCATTERING FOG                              -->
    <!-- Simulates suspended particulates, dust backscatter & realistic haze  -->
    <!-- =================================================================== -->
    <scene>
      <ambient>0.18 0.26 0.30 1.0</ambient>
      <background>0.09 0.16 0.20 1.0</background>
      <shadows>false</shadows>
      <grid>false</grid>
      <!-- Particulate haze: optical attenuation and backscatter -->
      <fog>
        <type>linear</type>
        <color>0.11 0.22 0.26 1.0</color>
        <density>0.35</density>
        <start>0.5</start>
        <end>5.5</end>
      </fog>
    </scene>

    <!-- Natural Overhead Sun Filtering Through Water Surface -->
    <light type="directional" name="surface_sun">
      <cast_shadows>false</cast_shadows>
      <pose>10.0 0.0 12.0 0 0 0</pose>
      <diffuse>0.42 0.52 0.56 1.0</diffuse>
      <specular>0.25 0.35 0.40 0.6</specular>
      <direction>-0.15 0.08 -0.98</direction>
    </light>

    <!-- Underwater Backscatter Ambient Fill Light -->
    <light type="directional" name="water_ambient_fill">
      <cast_shadows>false</cast_shadows>
      <pose>10.0 0.0 -0.5 0 0 0</pose>
      <diffuse>0.14 0.20 0.22 1.0</diffuse>
      <specular>0.02 0.02 0.02 1.0</specular>
      <direction>0.0 0.0 -1.0</direction>
    </light>

    <!-- =================================================================== -->
    <!-- SUSPENDED DUST & MARINE SNOW PARTICLE EMITTERS                      -->
    <!-- =================================================================== -->
    <model name="underwater_dust_emitter">
      <static>true</static>
      <pose>10.0 0.0 -0.85 0 0 0</pose>
      <link name="emitter_link">
        <particle_emitter name="dust_snow" type="box">
          <emitting>true</emitting>
          <size>18.0 8.5 1.4</size>
          <particle_size>0.015 0.015 0.015</particle_size>
          <lifetime>20.0</lifetime>
          <min_velocity>0.005</min_velocity>
          <max_velocity>0.035</max_velocity>
          <scale_rate>0.2</scale_rate>
          <rate>75</rate>
          <material>
            <ambient>0.65 0.72 0.60 0.65</ambient>
            <diffuse>0.65 0.72 0.60 0.65</diffuse>
            <specular>0.15 0.15 0.15 0.5</specular>
          </material>
        </particle_emitter>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- SEABED BOTTOM (Sandy/Silty Marine Floor, Dunes & Boulders)          -->
    <!-- =================================================================== -->
    <!-- Primary Sloping Marine Sand & Silt Bed -->
    <model name="seabed_floor">
      <static>true</static>
      <pose>10 0 -1.25009 0 0.0599282 0</pose>
      <link name="link">
        <visual name="sand_bed">
          <geometry><box><size>20.236 10.2 0.1</size></box></geometry>
          <material>
            <!-- Natural Marine Sand & Silt Color -->
            <ambient>0.42 0.36 0.25 1.0</ambient>
            <diffuse>0.52 0.44 0.32 1.0</diffuse>
            <specular>0.03 0.03 0.03 1.0</specular>
          </material>
        </visual>
        <collision name="c">
          <geometry><box><size>20.236 10.2 0.1</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Seabed Sand Dune Ripple 1 (x = 3.5 m) -->
    <model name="seabed_dune_1">
      <static>true</static>
      <pose>3.5 0.0 -0.80 0 0.06 0</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>1.6 9.8 0.08</size></box></geometry>
          <material><ambient>0.45 0.39 0.27 1</ambient><diffuse>0.55 0.47 0.34 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Seabed Sand Dune Ripple 2 (x = 8.5 m) -->
    <model name="seabed_dune_2">
      <static>true</static>
      <pose>8.5 0.0 -1.10 0 0.06 0</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>2.0 9.8 0.10</size></box></geometry>
          <material><ambient>0.40 0.34 0.24 1</ambient><diffuse>0.50 0.42 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Seabed Sand Dune Ripple 3 (x = 13.5 m) -->
    <model name="seabed_dune_3">
      <static>true</static>
      <pose>13.5 0.0 -1.40 0 0.06 0</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>2.4 9.8 0.12</size></box></geometry>
          <material><ambient>0.38 0.32 0.22 1</ambient><diffuse>0.48 0.40 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Seabed Granite Boulder 1 (x = 5.2 m, y = -2.2 m) -->
    <model name="seabed_boulder_1">
      <static>true</static>
      <pose>5.2 -2.2 -0.82 0.15 0.25 0.4</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>0.65 0.55 0.35</size></box></geometry>
          <material><ambient>0.28 0.26 0.24 1</ambient><diffuse>0.34 0.32 0.29 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.65 0.55 0.35</size></box></geometry></collision>
      </link>
    </model>

    <!-- Seabed Granite Boulder 2 (x = 9.8 m, y = 2.4 m) -->
    <model name="seabed_boulder_2">
      <static>true</static>
      <pose>9.8 2.4 -1.12 -0.1 0.3 1.1</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>0.80 0.70 0.42</size></box></geometry>
          <material><ambient>0.26 0.25 0.22 1</ambient><diffuse>0.32 0.30 0.27 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.80 0.70 0.42</size></box></geometry></collision>
      </link>
    </model>

    <!-- Seabed Gravel Cluster (x = 12.2 m, y = -1.8 m) -->
    <model name="seabed_gravel_1">
      <static>true</static>
      <pose>12.2 -1.8 -1.35 0 0 0.5</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>1.2 1.4 0.15</size></box></geometry>
          <material><ambient>0.35 0.32 0.26 1</ambient><diffuse>0.42 0.38 0.32 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Seabed Reef Rock Formation (x = 15.6 m, y = 1.8 m) -->
    <model name="seabed_reef_rock">
      <static>true</static>
      <pose>15.6 1.8 -1.50 0.2 0.1 0.8</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>0.95 0.85 0.50</size></box></geometry>
          <material><ambient>0.30 0.28 0.25 1</ambient><diffuse>0.36 0.34 0.30 1</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.95 0.85 0.50</size></box></geometry></collision>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- POOL PERIMETER WALLS                                                -->
    <!-- =================================================================== -->
    <model name="wall_start"><static>true</static><pose>-0.05 0 -0.7 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>0.1 10 2.2</size></box></geometry><material><ambient>0.45 0.52 0.56 1</ambient><diffuse>0.45 0.52 0.56 1</diffuse></material></visual><collision name="c"><geometry><box><size>0.1 10 2.2</size></box></geometry></collision></link></model>
    <model name="wall_end"><static>true</static><pose>20.05 0 -0.7 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>0.1 10 2.2</size></box></geometry><material><ambient>0.45 0.52 0.56 1</ambient><diffuse>0.45 0.52 0.56 1</diffuse></material></visual><collision name="c"><geometry><box><size>0.1 10 2.2</size></box></geometry></collision></link></model>
    <model name="wall_left"><static>true</static><pose>10 5.05 -0.7 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>20 0.1 2.2</size></box></geometry><material><ambient>0.45 0.52 0.56 1</ambient><diffuse>0.45 0.52 0.56 1</diffuse></material></visual><collision name="c"><geometry><box><size>20 0.1 2.2</size></box></geometry></collision></link></model>
    <model name="wall_right"><static>true</static><pose>10 -5.05 -0.7 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>20 0.1 2.2</size></box></geometry><material><ambient>0.45 0.52 0.56 1</ambient><diffuse>0.45 0.52 0.56 1</diffuse></material></visual><collision name="c"><geometry><box><size>20 0.1 2.2</size></box></geometry></collision></link></model>

    <!-- Translucent Water Surface with Sun Refraction -->
    <model name="water_surface">
      <static>true</static>
      <pose>10 0 0 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>20 10 0.002</size></box></geometry>
          <material>
            <ambient>0.12 0.38 0.52 0.35</ambient>
            <diffuse>0.14 0.42 0.58 0.35</diffuse>
            <specular>0.6 0.7 0.8 0.6</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- FLOATING PLASTIC & DUST ON / ABOVE WATER SURFACE (z >= 0.0 m)       -->
    <!-- =================================================================== -->
    <!-- Surface Floating PET Plastic Bottle 1 (Empty 1L, horizontal at z = +0.018 m) -->
    <model name="surface_plastic_bottle_1">
      <static>true</static>
      <pose>2.8 0.8 0.018 0 1.5708 0.35</pose>
      <link name="link">
        <visual name="bottle_body">
          <geometry><cylinder><radius>0.042</radius><length>0.24</length></cylinder></geometry>
          <material>
            <ambient>0.75 0.88 0.95 0.60</ambient>
            <diffuse>0.80 0.92 0.98 0.60</diffuse>
            <specular>0.9 0.95 1.0 0.8</specular>
          </material>
        </visual>
        <!-- Bottle Blue Cap -->
        <visual name="cap">
          <pose>0 0 0.13 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.025</length></cylinder></geometry>
          <material><ambient>0.05 0.25 0.85 1.0</ambient><diffuse>0.05 0.25 0.85 1.0</diffuse></material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.042</radius><length>0.24</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Surface Floating PET Plastic Bottle 2 (x = 8.2 m, y = -1.2 m) -->
    <model name="surface_plastic_bottle_2">
      <static>true</static>
      <pose>8.2 -1.2 0.018 0.2 1.5708 -0.6</pose>
      <link name="link">
        <visual name="body">
          <geometry><cylinder><radius>0.038</radius><length>0.22</length></cylinder></geometry>
          <material><ambient>0.70 0.90 0.85 0.65</ambient><diffuse>0.75 0.92 0.88 0.65</diffuse><specular>0.8 0.9 0.9 0.7</specular></material>
        </visual>
        <visual name="cap">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.85 0.15 0.10 1.0</ambient></material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.038</radius><length>0.22</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Surface Floating Thermocol / Styrofoam Block 1 (White EPS, z = +0.03 m) -->
    <model name="surface_thermocol_block_1">
      <static>true</static>
      <pose>5.8 -0.7 0.028 0.05 -0.05 0.6</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.22 0.18 0.06</size></box></geometry>
          <material>
            <ambient>0.95 0.95 0.95 1.0</ambient>
            <diffuse>0.98 0.98 0.98 1.0</diffuse>
            <specular>0.2 0.2 0.2 0.4</specular>
          </material>
        </visual>
        <collision name="c"><geometry><box><size>0.22 0.18 0.06</size></box></geometry></collision>
      </link>
    </model>

    <!-- Surface Floating Thermocol Block 2 (x = 11.5 m, y = 1.4 m) -->
    <model name="surface_thermocol_block_2">
      <static>true</static>
      <pose>11.5 1.4 0.025 -0.04 0.08 -0.4</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.28 0.14 0.05</size></box></geometry>
          <material><ambient>0.92 0.92 0.90 1.0</ambient><diffuse>0.96 0.96 0.94 1.0</diffuse></material>
        </visual>
        <collision name="c"><geometry><box><size>0.28 0.14 0.05</size></box></geometry></collision>
      </link>
    </model>

    <!-- Surface Plastic Oil Jug / Jerrycan (x = 14.8 m, y = -0.5 m, z = +0.05 m) -->
    <model name="surface_plastic_canister">
      <static>true</static>
      <pose>14.8 -0.5 0.045 0.15 0.2 0.8</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.25 0.16 0.18</size></box></geometry>
          <material>
            <ambient>0.85 0.70 0.05 1.0</ambient>
            <diffuse>0.90 0.75 0.08 1.0</diffuse>
          </material>
        </visual>
        <collision name="c"><geometry><box><size>0.25 0.16 0.18</size></box></geometry></collision>
      </link>
    </model>

    <!-- Floating Spherical Dust Cluster 1 strictly inside water (z = -0.55 m) -->
    <model name="pool_dust_spheres_1">
      <static>true</static>
      <pose>6.5 1.0 -0.55 0 0 0</pose>
      <link name="link">
        <visual name="s1"><geometry><sphere><radius>0.022</radius></sphere></geometry><material><ambient>0.65 0.70 0.60 0.75</ambient><diffuse>0.65 0.70 0.60 0.75</diffuse></material></visual>
        <visual name="s2"><pose>0.10 0.08 -0.04 0 0 0</pose><geometry><sphere><radius>0.016</radius></sphere></geometry><material><ambient>0.62 0.68 0.58 0.7</ambient></material></visual>
        <visual name="s3"><pose>-0.08 -0.12 0.05 0 0 0</pose><geometry><sphere><radius>0.020</radius></sphere></geometry><material><ambient>0.64 0.70 0.60 0.75</ambient></material></visual>
      </link>
    </model>

    <!-- Floating Spherical Dust Cluster 2 strictly inside water (z = -0.85 m) -->
    <model name="pool_dust_spheres_2">
      <static>true</static>
      <pose>12.0 -1.5 -0.85 0 0 0.4</pose>
      <link name="link">
        <visual name="s1"><geometry><sphere><radius>0.025</radius></sphere></geometry><material><ambient>0.65 0.70 0.60 0.75</ambient><diffuse>0.65 0.70 0.60 0.75</diffuse></material></visual>
        <visual name="s2"><pose>-0.12 0.10 0.06 0 0 0</pose><geometry><sphere><radius>0.018</radius></sphere></geometry><material><ambient>0.62 0.68 0.58 0.7</ambient></material></visual>
        <visual name="s3"><pose>0.14 -0.09 -0.05 0 0 0</pose><geometry><sphere><radius>0.022</radius></sphere></geometry><material><ambient>0.64 0.70 0.60 0.75</ambient></material></visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- FLOATING PLASTIC & DUST IN THE WATER (Submerged at depth)           -->
    <!-- =================================================================== -->
    <!-- Submerged Water-Filled PET Plastic Bottle 1 (Neutral buoyancy, z = -0.45 m) -->
    <model name="submerged_bottle_1">
      <static>true</static>
      <pose>3.2 -0.4 -0.45 0.4 0.8 1.2</pose>
      <link name="link">
        <visual name="bottle">
          <geometry><cylinder><radius>0.04</radius><length>0.23</length></cylinder></geometry>
          <material>
            <ambient>0.60 0.78 0.88 0.55</ambient>
            <diffuse>0.65 0.82 0.92 0.55</diffuse>
            <specular>0.7 0.8 0.9 0.6</specular>
          </material>
        </visual>
        <visual name="cap">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.2 1.0</ambient></material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.04</radius><length>0.23</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Submerged Crinkled Plastic Bag / Polythene Sheet 1 (z = -0.65 m) -->
    <model name="submerged_plastic_bag_1">
      <static>true</static>
      <pose>5.2 0.4 -0.65 0.5 0.3 -0.7</pose>
      <link name="link">
        <visual name="bag_fold_1">
          <geometry><box><size>0.26 0.22 0.012</size></box></geometry>
          <material>
            <ambient>0.80 0.85 0.88 0.40</ambient>
            <diffuse>0.85 0.90 0.92 0.40</diffuse>
            <specular>0.5 0.6 0.7 0.5</specular>
          </material>
        </visual>
        <visual name="bag_fold_2">
          <pose>0.06 0.04 0.03 0.3 0.4 0</pose>
          <geometry><box><size>0.18 0.15 0.015</size></box></geometry>
          <material><ambient>0.80 0.85 0.88 0.45</ambient></material>
        </visual>
        <collision name="c"><geometry><box><size>0.26 0.22 0.012</size></box></geometry></collision>
      </link>
    </model>

    <!-- Submerged Translucent Plastic Takeaway Cup (z = -0.52 m) -->
    <model name="submerged_plastic_cup_1">
      <static>true</static>
      <pose>6.8 -1.1 -0.52 1.2 0.4 0.2</pose>
      <link name="link">
        <visual name="cup">
          <geometry><cylinder><radius>0.042</radius><length>0.12</length></cylinder></geometry>
          <material>
            <ambient>0.75 0.80 0.85 0.50</ambient>
            <diffuse>0.80 0.85 0.90 0.50</diffuse>
          </material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.042</radius><length>0.12</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Submerged Crushed Plastic Container 2 (z = -0.85 m) -->
    <model name="submerged_plastic_box_2">
      <static>true</static>
      <pose>9.2 -0.3 -0.85 0.3 0.7 0.9</pose>
      <link name="link">
        <visual name="box">
          <geometry><box><size>0.16 0.12 0.08</size></box></geometry>
          <material>
            <ambient>0.70 0.82 0.90 0.55</ambient>
            <diffuse>0.75 0.86 0.94 0.55</diffuse>
          </material>
        </visual>
        <collision name="c"><geometry><box><size>0.16 0.12 0.08</size></box></geometry></collision>
      </link>
    </model>

    <!-- Submerged Plastic Sheet 2 (Near obstacle maze entrance, z = -0.75 m) -->
    <model name="submerged_plastic_sheet_2">
      <static>true</static>
      <pose>12.8 0.2 -0.75 -0.4 0.6 0.5</pose>
      <link name="link">
        <visual name="sheet">
          <geometry><box><size>0.32 0.25 0.015</size></box></geometry>
          <material>
            <ambient>0.72 0.82 0.78 0.42</ambient>
            <diffuse>0.76 0.86 0.82 0.42</diffuse>
          </material>
        </visual>
        <collision name="c"><geometry><box><size>0.32 0.25 0.015</size></box></geometry></collision>
      </link>
    </model>

    <!-- Submerged Bottle 3 (Deep end, z = -1.15 m) -->
    <model name="submerged_bottle_3">
      <static>true</static>
      <pose>15.2 -0.2 -1.15 0.6 0.2 -0.8</pose>
      <link name="link">
        <visual name="bottle">
          <geometry><cylinder><radius>0.045</radius><length>0.26</length></cylinder></geometry>
          <material><ambient>0.55 0.75 0.85 0.50</ambient><diffuse>0.60 0.80 0.90 0.50</diffuse></material>
        </visual>
        <collision name="c"><geometry><cylinder><radius>0.045</radius><length>0.26</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Suspended Silt / Dust Particulate Cloud 1 (z = -0.60 m) -->
    <model name="suspended_dust_cloud_1">
      <static>true</static>
      <pose>4.2 0.2 -0.60 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>1.8 1.4 0.6</size></box></geometry>
          <material>
            <ambient>0.50 0.55 0.45 0.22</ambient>
            <diffuse>0.55 0.60 0.48 0.22</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Suspended Silt / Dust Particulate Cloud 2 (Near balloons, z = -0.70 m) -->
    <model name="suspended_dust_cloud_2">
      <static>true</static>
      <pose>8.0 0.0 -0.70 0 0 0.3</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>2.2 2.0 0.7</size></box></geometry>
          <material>
            <ambient>0.48 0.52 0.42 0.25</ambient>
            <diffuse>0.52 0.58 0.46 0.25</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Suspended Silt / Dust Particulate Cloud 3 (Deep slalom maze, z = -1.05 m) -->
    <model name="suspended_dust_cloud_3">
      <static>true</static>
      <pose>14.0 0.0 -1.05 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>2.8 1.6 0.8</size></box></geometry>
          <material>
            <ambient>0.45 0.50 0.40 0.24</ambient>
            <diffuse>0.50 0.55 0.44 0.24</diffuse>
          </material>
        </visual>
      </link>
    </model>

