    <model name="obstacle_2"><static>true</static><pose>14 -0.25 -0.81 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.025</radius><length>1.26</length></cylinder></geometry><material><ambient>0.8 0.8 0.78 1</ambient><diffuse>0.8 0.8 0.78 1</diffuse></material></visual><collision name="c"><geometry><cylinder><radius>0.025</radius><length>1.26</length></cylinder></geometry></collision></link></model>
