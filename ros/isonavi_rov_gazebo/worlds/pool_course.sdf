    <model name="balloon_red_string"><static>true</static><pose>7.5 -1.8 -0.86 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.002</radius><length>0.38</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name="balloon_green"><static>true</static><pose>7.5 -0.6 -0.55 0 0 0</pose><link name="link"><visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry><material><ambient>0.06 0.55 0.12 1</ambient><diffuse>0.06 0.55 0.12 1</diffuse></material></visual><collision name="c"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision></link></model>
    <model name="balloon_green_string"><static>true</static><pose>7.5 -0.6 -0.86 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.002</radius><length>0.38</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name="balloon_blue"><static>true</static><pose>7.5 0.6 -0.55 0 0 0</pose><link name="link"><visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry><material><ambient>0.05 0.12 0.65 1</ambient><diffuse>0.05 0.12 0.65 1</diffuse></material></visual><collision name="c"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision></link></model>
    <model name="balloon_blue_string"><static>true</static><pose>7.5 0.6 -0.86 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.002</radius><length>0.38</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name="balloon_yellow"><static>true</static><pose>7.5 1.8 -0.55 0 0 0</pose><link name="link"><visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry><material><ambient>0.78 0.68 0.05 1</ambient><diffuse>0.78 0.68 0.05 1</diffuse></material></visual><collision name="c"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision></link></model>
    <model name="balloon_yellow_string"><static>true</static><pose>7.5 1.8 -0.86 0 0 0</pose><link name="link"><visual name="v"><geometry><cylinder><radius>0.002</radius><length>0.38</length></cylinder></geometry><material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>

    <!-- Slalom Obstacle Maze Walls & Columns -->
