<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="pool_course">

    <!-- Physics Engine Configuration -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo Harmonic Simulation Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000.0</default_density>
        <density_change>
          <above_depth>0.0</above_depth>
          <density>1.2</density>
        </density_change>
      </graded_buoyancy>
      <enable>isonavi_rov::base_link</enable>
    </plugin>

    <!-- Underwater Ambient Lighting & Illumination -->
    <light type="directional" name="sun_attenuated">
      <cast_shadows>true</cast_shadows>
      <pose>10 0 10 0 0 0</pose>
      <diffuse>0.3 0.35 0.45 1.0</diffuse>
      <specular>0.1 0.1 0.2 1.0</specular>
      <direction>-0.2 0.1 -0.9</direction>
    </light>

    <!-- Water Surface Visual Plane (z = 0.0 m) -->
    <model name="water_surface">
      <static>true</static>
      <pose>10.0 0.0 0.0 0 0 0</pose>
      <link name="surface_link">
        <visual name="surface_visual">
          <geometry><box><size>20.0 10.0 0.002</size></box></geometry>
          <material>
            <ambient>0.1 0.4 0.6 0.3</ambient>
            <diffuse>0.1 0.4 0.6 0.3</diffuse>
            <specular>0.8 0.8 0.9 0.5</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- POOL ARENA BASIN (20 m length x 10 m width, sloping floor 0.6 to 1.8 m)-->
    <!-- =================================================================== -->
    <!-- Sloping Pool Floor -->
    <model name="pool_floor">
      <static>true</static>
      <!-- Center at x = 10 m, z = -(0.6 + 1.8)/2 = -1.2 m, pitch = atan(1.2/20) = 0.0599 rad -->
      <pose>10.0 0.0 -1.20 0 0.059929 0</pose>
      <link name="floor_link">
        <visual name="floor_visual">
          <geometry><box><size>20.04 10.0 0.10</size></box></geometry>
          <material>
            <ambient>0.55 0.62 0.66 1.0</ambient>
            <diffuse>0.55 0.62 0.66 1.0</diffuse>
          </material>
        </visual>
        <collision name="floor_collision">
          <geometry><box><size>20.04 10.0 0.10</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Perimeter Walls -->
    <model name="pool_wall_start">
      <static>true</static>
      <pose>-0.05 0.0 -0.5 0 0 0</pose>
      <link name="wall_link">
        <visual name="v"><geometry><box><size>0.1 10.0 2.0</size></box></geometry>
        <material><ambient>0.5 0.6 0.65 1</ambient><diffuse>0.5 0.6 0.65 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.1 10.0 2.0</size></box></geometry></collision>
      </link>
    </model>

    <model name="pool_wall_end">
      <static>true</static>
      <pose>20.05 0.0 -1.0 0 0 0</pose>
      <link name="wall_link">
        <visual name="v"><geometry><box><size>0.1 10.0 2.5</size></box></geometry>
        <material><ambient>0.5 0.6 0.65 1</ambient><diffuse>0.5 0.6 0.65 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.1 10.0 2.5</size></box></geometry></collision>
      </link>
    </model>

    <model name="pool_wall_port">
      <static>true</static>
      <pose>10.0 5.05 -1.0 0 0 0</pose>
      <link name="wall_link">
        <visual name="v"><geometry><box><size>20.0 0.1 2.5</size></box></geometry>
        <material><ambient>0.5 0.6 0.65 1</ambient><diffuse>0.5 0.6 0.65 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>20.0 0.1 2.5</size></box></geometry></collision>
      </link>
    </model>

    <model name="pool_wall_stbd">
      <static>true</static>
      <pose>10.0 -5.05 -1.0 0 0 0</pose>
      <link name="wall_link">
        <visual name="v"><geometry><box><size>20.0 0.1 2.5</size></box></geometry>
        <material><ambient>0.5 0.6 0.65 1</ambient><diffuse>0.5 0.6 0.65 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>20.0 0.1 2.5</size></box></geometry></collision>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- SUBMERGED PVC GATE (x = 4.0 m, 1.0 m clear opening, depth = 0.25 m) -->
    <!-- =================================================================== -->
    <model name="submerged_gate">
      <static>true</static>
      <pose>4.0 0.0 0.0 0 0 0</pose>
      <link name="gate_link">
        <!-- Left Post (y = +0.525 m, floor at z = -0.84 m, top at z = -0.25 m) -->
        <visual name="post_left_visual">
          <pose>0.0 0.525 -0.545 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.590</length></cylinder></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
        </visual>
        <collision name="post_left_col">
          <pose>0.0 0.525 -0.545 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.590</length></cylinder></geometry>
        </collision>

        <!-- Right Post (y = -0.525 m) -->
        <visual name="post_right_visual">
          <pose>0.0 -0.525 -0.545 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.590</length></cylinder></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
        </visual>
        <collision name="post_right_col">
          <pose>0.0 -0.525 -0.545 0 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>0.590</length></cylinder></geometry>
        </collision>

        <!-- Crossbar (z = -0.225 m) -->
        <visual name="crossbar_visual">
          <pose>0.0 0.0 -0.225 1.5707963 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.10</length></cylinder></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
        </visual>
        <collision name="crossbar_col">
          <pose>0.0 0.0 -0.225 1.5707963 0 0</pose>
          <geometry><cylinder><radius>0.025</radius><length>1.10</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- TARGET LINE (x = 7.5 m, depth = 0.55 m, 4 tethered colored balloons)-->
    <!-- =================================================================== -->
    <!-- Red Balloon (Target) -->
    <model name="balloon_red">
      <static>true</static>
      <pose>7.5 -1.8 -0.55 0 0 0</pose>
      <link name="balloon_link">
        <visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material><ambient>0.85 0.08 0.06 1</ambient><diffuse>0.85 0.08 0.06 1</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision>
        <!-- Floor tether string -->
        <visual name="tether"><pose>0 0 -0.25 0 0 0</pose><geometry><cylinder><radius>0.003</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Green Balloon -->
    <model name="balloon_green">
      <static>true</static>
      <pose>7.5 -0.6 -0.55 0 0 0</pose>
      <link name="balloon_link">
        <visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material><ambient>0.08 0.80 0.15 1</ambient><diffuse>0.08 0.80 0.15 1</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision>
        <visual name="tether"><pose>0 0 -0.25 0 0 0</pose><geometry><cylinder><radius>0.003</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Blue Balloon -->
    <model name="balloon_blue">
      <static>true</static>
      <pose>7.5 0.6 -0.55 0 0 0</pose>
      <link name="balloon_link">
        <visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material><ambient>0.08 0.18 0.85 1</ambient><diffuse>0.08 0.18 0.85 1</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision>
        <visual name="tether"><pose>0 0 -0.25 0 0 0</pose><geometry><cylinder><radius>0.003</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Yellow Balloon -->
    <model name="balloon_yellow">
      <static>true</static>
      <pose>7.5 1.8 -0.55 0 0 0</pose>
      <link name="balloon_link">
        <visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material><ambient>0.90 0.85 0.08 1</ambient><diffuse>0.90 0.85 0.08 1</diffuse></material></visual>
        <collision name="c"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision>
        <visual name="tether"><pose>0 0 -0.25 0 0 0</pose><geometry><cylinder><radius>0.003</radius><length>0.50</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- THREE-SECTION OBSTACLE MAZE (x = 10.0 m to 18.0 m)                  -->
    <!-- =================================================================== -->
    <!-- Corridor Left Wall (y = +0.525 m, clear opening = 1.0 m) -->
    <model name="maze_left_wall">
      <static>true</static>
      <pose>14.0 0.525 -0.75 0 0 0</pose>
      <link name="wall_link">
        <visual name="v"><geometry><box><size>8.0 0.05 1.50</size></box></geometry>
        <material><ambient>0.35 0.36 0.37 1</ambient><diffuse>0.35 0.36 0.37 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>8.0 0.05 1.50</size></box></geometry></collision>
      </link>
    </model>

    <!-- Corridor Right Wall (y = -0.525 m) -->
    <model name="maze_right_wall">
      <static>true</static>
      <pose>14.0 -0.525 -0.75 0 0 0</pose>
      <link name="wall_link">
        <visual name="v"><geometry><box><size>8.0 0.05 1.50</size></box></geometry>
        <material><ambient>0.35 0.36 0.37 1</ambient><diffuse>0.35 0.36 0.37 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>8.0 0.05 1.50</size></box></geometry></collision>
      </link>
    </model>

    <!-- Section 2: Obstacle Slalom Posts (x = 12.5 to 15.5 m) -->
    <!-- Post 1 (x = 13.25 m, offset y = +0.25 m) -->
    <model name="obstacle_post_1">
      <static>true</static>
      <pose>13.25 0.25 -0.75 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.025</radius><length>1.50</length></cylinder></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.025</radius><length>1.50</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Post 2 (x = 14.00 m, offset y = -0.25 m) -->
    <model name="obstacle_post_2">
      <static>true</static>
      <pose>14.00 -0.25 -0.75 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.025</radius><length>1.50</length></cylinder></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.025</radius><length>1.50</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Post 3 (x = 14.75 m, offset y = +0.25 m) -->
    <model name="obstacle_post_3">
      <static>true</static>
      <pose>14.75 0.25 -0.75 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.025</radius><length>1.50</length></cylinder></geometry>
        <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
        <collision name="c"><geometry><cylinder><radius>0.025</radius><length>1.50</length></cylinder></geometry></collision>
      </link>
    </model>

    <!-- Section 3: Covered Passage Roof (x = 15.5 to 18.0 m, roof at z = -0.45 m) -->
    <model name="passage_roof">
      <static>true</static>
      <pose>16.75 0.0 -0.45 0 0 0</pose>
      <link name="roof_link">
        <visual name="v"><geometry><box><size>2.50 1.10 0.05</size></box></geometry>
        <material><ambient>0.35 0.36 0.37 1</ambient><diffuse>0.35 0.36 0.37 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2.50 1.10 0.05</size></box></geometry></collision>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- ROBOT MODEL: isonavi_rov SPAWNED AT START (x = 1.2 m, z = -0.40 m)  -->
    <!-- =================================================================== -->
    <include>
      <uri>model://isonavi_rov</uri>
      <name>isonavi_rov</name>
      <pose>1.2 0.0 -0.40 0 0 0</pose>
      <!-- Odometry Publisher Plugin -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/model/isonavi_rov/odometry</odom_topic>
        <robot_base_frame>isonavi_rov::base_link</robot_base_frame>
        <dimensions>3</dimensions>
      </plugin>
    </include>

  </world>
</sdf>
