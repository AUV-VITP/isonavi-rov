<?xml version="1.0"?>
<package format="3">
  <name>isonavi_rov_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Harmonic simulation world and ROS 2 bridges for isonavi-rov.</description>
  <maintainer email="toaadijoshi@gmail.com">Aadi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>isonavi_rov_ros</exec_depend>
  <exec_depend>isonavi_rov_description</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
