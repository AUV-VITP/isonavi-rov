<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="isonavi_rov">

  <!-- Base Link: Chassis & Electronics -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 -0.041" rpy="0 0 0"/>
      <mass value="10.490"/>
      <inertia ixx="0.126" ixy="0.0" ixz="0.0" iyy="0.288" iyz="0.0" izz="0.334"/>
    </inertial>

    <visual>
      <origin xyz="0.030 0 0.040" rpy="0 1.5707963 0"/>
      <geometry>
        <cylinder radius="0.057" length="0.300"/>
      </geometry>
      <material name="acrylic">
        <color rgba="0.70 0.82 0.90 0.6"/>
      </material>
    </visual>

    <visual>
      <origin xyz="0 0 0.145" rpy="0 0 0"/>
      <geometry>
        <box size="0.280 0.240 0.032"/>
      </geometry>
      <material name="foam">
        <color rgba="0.93 0.80 0.25 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 -0.041" rpy="0 0 0"/>
      <geometry>
        <box size="0.600 0.440 0.330"/>
      </geometry>
    </collision>
  </link>

  <!-- Camera Optical Link -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.190 0 0.040" rpy="0 0 0"/>
  </joint>

  <!-- IMU Link -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Thruster Links & Joints for Kinematics -->
  <xacro:macro name="thruster_joint" params="id x y z yaw pitch">
    <link name="thruster_${id}_link"/>
    <joint name="thruster_${id}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="thruster_${id}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 ${pitch} ${yaw}"/>
      <axis xyz="1 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:thruster_joint id="1" x="0.215" y="0.150" z="-0.060" yaw="0.785398" pitch="0"/>
  <xacro:thruster_joint id="2" x="0.215" y="-0.150" z="-0.060" yaw="-0.785398" pitch="0"/>
  <xacro:thruster_joint id="3" x="-0.215" y="0.150" z="-0.060" yaw="-0.785398" pitch="0"/>
  <xacro:thruster_joint id="4" x="-0.215" y="-0.150" z="-0.060" yaw="0.785398" pitch="0"/>
  <xacro:thruster_joint id="5" x="0.130" y="0.155" z="0.100" yaw="0" pitch="-1.570796"/>
  <xacro:thruster_joint id="6" x="0.130" y="-0.155" z="0.100" yaw="0" pitch="-1.570796"/>
  <xacro:thruster_joint id="7" x="-0.130" y="0.155" z="0.100" yaw="0" pitch="-1.570796"/>
  <xacro:thruster_joint id="8" x="-0.130" y="-0.155" z="0.100" yaw="0" pitch="-1.570796"/>

</robot>
