<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="isonavi_rov">
    <pose>0 0 0 0 0 0</pose>

    <!-- ==================================================================== -->
    <!-- BASE LINK: Main Chassis, Enclosure, Buoyancy Foam & Lead Ballast     -->
    <!-- ==================================================================== -->
    <link name="base_link">
      <inertial>
        <pose>0.0 0.0 -0.0410 0 0 0</pose>
        <mass>10.490</mass>
        <inertia>
          <ixx>0.126</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.288</iyy>
          <iyz>0.0</iyz>
          <izz>0.334</izz>
        </inertia>
        <fluid_added_mass>
          <xx>5.01</xx>
          <yy>5.61</yy>
          <zz>14.71</zz>
          <pp>0.125</pp>
          <qq>0.089</qq>
          <rr>0.146</rr>
        </fluid_added_mass>
      </inertial>

      <!-- VISUALS -->
      <!-- Acrylic Pressure Tube -->
      <visual name="acrylic_tube_visual">
        <pose>0.030 0.0 0.040 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.057</radius>
            <length>0.300</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.70 0.82 0.90 0.6</ambient>
          <diffuse>0.70 0.82 0.90 0.6</diffuse>
          <specular>0.9 0.9 0.9 0.8</specular>
        </material>
      </visual>

      <!-- Rear Aluminum End Cap -->
      <visual name="rear_cap_visual">
        <pose>-0.128 0.0 0.040 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.062</radius>
            <length>0.016</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.62 0.64 0.68 1.0</ambient>
          <diffuse>0.62 0.64 0.68 1.0</diffuse>
        </material>
      </visual>

      <!-- Front Aluminum Port Ring -->
      <visual name="front_ring_visual">
        <pose>0.188 0.0 0.040 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.062</radius>
            <length>0.016</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.62 0.64 0.68 1.0</ambient>
          <diffuse>0.62 0.64 0.68 1.0</diffuse>
        </material>
      </visual>

      <!-- Flat Acrylic Camera Window -->
      <visual name="front_port_visual">
        <pose>0.198 0.0 0.040 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.057</radius>
            <length>0.010</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.95 1.0 0.4</ambient>
          <diffuse>0.9 0.95 1.0 0.4</diffuse>
        </material>
      </visual>

      <!-- Port Side HDPE Frame Plate -->
      <visual name="port_plate_visual">
        <pose>0.0 0.220 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.600 0.010 0.330</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20 0.22 0.27 1.0</ambient>
          <diffuse>0.20 0.22 0.27 1.0</diffuse>
        </material>
      </visual>

      <!-- Starboard Side HDPE Frame Plate -->
      <visual name="stbd_plate_visual">
        <pose>0.0 -0.220 0.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.600 0.010 0.330</size>
          </box>
        </geometry>
        <material>
          <ambient>0.20 0.22 0.27 1.0</ambient>
          <diffuse>0.20 0.22 0.27 1.0</diffuse>
        </material>
      </visual>

      <!-- Transverse Cross Members (4x) -->
      <visual name="cross_top_fore">
        <pose>0.220 0.0 0.120 0 0 0</pose>
        <geometry><box><size>0.040 0.420 0.010</size></box></geometry>
        <material><ambient>0.25 0.25 0.30 1.0</ambient><diffuse>0.25 0.25 0.30 1.0</diffuse></material>
      </visual>
      <visual name="cross_top_aft">
        <pose>-0.220 0.0 0.120 0 0 0</pose>
        <geometry><box><size>0.040 0.420 0.010</size></box></geometry>
        <material><ambient>0.25 0.25 0.30 1.0</ambient><diffuse>0.25 0.25 0.30 1.0</diffuse></material>
      </visual>
      <visual name="cross_bot_fore">
        <pose>0.220 0.0 -0.130 0 0 0</pose>
        <geometry><box><size>0.040 0.420 0.010</size></box></geometry>
        <material><ambient>0.25 0.25 0.30 1.0</ambient><diffuse>0.25 0.25 0.30 1.0</diffuse></material>
      </visual>
      <visual name="cross_bot_aft">
        <pose>-0.220 0.0 -0.130 0 0 0</pose>
        <geometry><box><size>0.040 0.420 0.010</size></box></geometry>
        <material><ambient>0.25 0.25 0.30 1.0</ambient><diffuse>0.25 0.25 0.30 1.0</diffuse></material>
      </visual>

      <!-- Bottom Skids (2x) -->
      <visual name="skid_port">
        <pose>0.0 0.160 -0.155 0 0 0</pose>
        <geometry><box><size>0.570 0.020 0.020</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1.0</ambient><diffuse>0.2 0.2 0.2 1.0</diffuse></material>
      </visual>
      <visual name="skid_stbd">
        <pose>0.0 -0.160 -0.155 0 0 0</pose>
        <geometry><box><size>0.570 0.020 0.020</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1.0</ambient><diffuse>0.2 0.2 0.2 1.0</diffuse></material>
      </visual>

      <!-- Syntactic Buoyancy Foam Block (Top) -->
      <visual name="foam_block_visual">
        <pose>0.0 0.0 0.145 0 0 0</pose>
        <geometry>
          <box>
            <size>0.280 0.240 0.032</size>
          </box>
        </geometry>
        <material>
          <ambient>0.93 0.80 0.25 1.0</ambient>
          <diffuse>0.93 0.80 0.25 1.0</diffuse>
        </material>
      </visual>

      <!-- Lead Trim Ballast (Bottom) -->
      <visual name="lead_ballast_visual">
        <pose>0.0 0.0 -0.150 0 0 0</pose>
        <geometry>
          <box>
            <size>0.100 0.080 0.015</size>
          </box>
        </geometry>
        <material>
          <ambient>0.34 0.35 0.40 1.0</ambient>
          <diffuse>0.34 0.35 0.40 1.0</diffuse>
        </material>
      </visual>

      <!-- LED Lamps (2x, 15 W COB) -->
      <visual name="lamp_port_visual">
        <pose>0.230 0.180 0.040 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.060</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.85 1.0</ambient>
          <diffuse>0.95 0.95 0.85 1.0</diffuse>
          <emissive>0.8 0.8 0.7 1.0</emissive>
        </material>
      </visual>
      <visual name="lamp_stbd_visual">
        <pose>0.230 -0.180 0.040 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.018</radius>
            <length>0.060</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.95 0.95 0.85 1.0</ambient>
          <diffuse>0.95 0.95 0.85 1.0</diffuse>
          <emissive>0.8 0.8 0.7 1.0</emissive>
        </material>
      </visual>

      <!-- Touch Probe -->
      <visual name="touch_probe_visual">
        <pose>0.290 0.0 -0.070 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.140</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1.0</ambient>
          <diffuse>0.8 0.8 0.8 1.0</diffuse>
        </material>
      </visual>

      <!-- Tether Strain Relief Gland -->
      <visual name="tether_gland_visual">
        <pose>-0.280 0.0 0.050 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.040</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>

      <!-- External Kill Switch -->
      <visual name="kill_switch_visual">
        <pose>-0.220 0.0 0.135 0 0 0</pose>
        <geometry>
          <box>
            <size>0.030 0.030 0.020</size>
          </box>
        </geometry>
        <material>
          <ambient>0.85 0.12 0.10 1.0</ambient>
          <diffuse>0.85 0.12 0.10 1.0</diffuse>
        </material>
      </visual>

      <!-- Thruster Ducts (Visuals on Base Link) -->
      <!-- T1 (Fore-Port Horizontal) -->
      <visual name="t1_duct">
        <pose>0.215 0.150 -0.060 0 0 0.785398</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.050</length></cylinder></geometry>
        <material><ambient>0.86 0.55 0.16 1.0</ambient><diffuse>0.86 0.55 0.16 1.0</diffuse></material>
      </visual>
      <!-- T2 (Fore-Starboard Horizontal) -->
      <visual name="t2_duct">
        <pose>0.215 -0.150 -0.060 0 0 -0.785398</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.050</length></cylinder></geometry>
        <material><ambient>0.86 0.55 0.16 1.0</ambient><diffuse>0.86 0.55 0.16 1.0</diffuse></material>
      </visual>
      <!-- T3 (Aft-Port Horizontal) -->
      <visual name="t3_duct">
        <pose>-0.215 0.150 -0.060 0 0 -0.785398</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.050</length></cylinder></geometry>
        <material><ambient>0.86 0.55 0.16 1.0</ambient><diffuse>0.86 0.55 0.16 1.0</diffuse></material>
      </visual>
      <!-- T4 (Aft-Starboard Horizontal) -->
      <visual name="t4_duct">
        <pose>-0.215 -0.150 -0.060 0 0 0.785398</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.050</length></cylinder></geometry>
        <material><ambient>0.86 0.55 0.16 1.0</ambient><diffuse>0.86 0.55 0.16 1.0</diffuse></material>
      </visual>
      <!-- T5 (Fore-Port Vertical) -->
      <visual name="t5_duct">
        <pose>0.130 0.155 0.100 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.050</length></cylinder></geometry>
        <material><ambient>0.86 0.55 0.16 1.0</ambient><diffuse>0.86 0.55 0.16 1.0</diffuse></material>
      </visual>
      <!-- T6 (Fore-Starboard Vertical) -->
      <visual name="t6_duct">
        <pose>0.130 -0.155 0.100 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.050</length></cylinder></geometry>
        <material><ambient>0.86 0.55 0.16 1.0</ambient><diffuse>0.86 0.55 0.16 1.0</diffuse></material>
      </visual>
      <!-- T7 (Aft-Port Vertical) -->
      <visual name="t7_duct">
        <pose>-0.130 0.155 0.100 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.050</length></cylinder></geometry>
        <material><ambient>0.86 0.55 0.16 1.0</ambient><diffuse>0.86 0.55 0.16 1.0</diffuse></material>
      </visual>
      <!-- T8 (Aft-Starboard Vertical) -->
      <visual name="t8_duct">
        <pose>-0.130 -0.155 0.100 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.050</length></cylinder></geometry>
        <material><ambient>0.86 0.55 0.16 1.0</ambient><diffuse>0.86 0.55 0.16 1.0</diffuse></material>
      </visual>

      <!-- ================================================================= -->
      <!-- COLLISION ELEMENTS: Engineered for exact Buoyancy V=10.70 L,       -->
      <!-- Net Buoyancy = +2.00 N, and Center of Buoyancy r_b=[0, 0, +0.004]  -->
      <!-- ================================================================= -->
      <collision name="hull_collision">
        <pose>0.030 0.0 0.040 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.057</radius>
            <length>0.300</length>
          </cylinder>
        </geometry>
      </collision>

      <collision name="foam_collision">
        <pose>0.0 0.0 0.145 0 0 0</pose>
        <geometry>
          <box>
            <size>0.280 0.240 0.032</size>
          </box>
        </geometry>
      </collision>

      <collision name="lower_chassis_collision">
        <pose>-0.0167 0.0 -0.0713 0 0 0</pose>
        <geometry>
          <box>
            <size>0.420 0.280 0.04666</size>
          </box>
        </geometry>
      </collision>

      <collision name="probe_collision">
        <pose>0.290 0.0 -0.070 0 1.57079632679 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.140</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- ================================================================= -->
      <!-- SENSORS                                                           -->
      <!-- ================================================================= -->
      <!-- Wide-angle Camera Module -->
      <sensor name="camera" type="camera">
        <pose>0.190 0.0 0.040 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>20.0</update_rate>
        <topic>/model/isonavi_rov/camera/image</topic>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov> <!-- 80 deg in water -->
          <image>
            <width>160</width>
            <height>120</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.004</stddev>
          </noise>
        </camera>
      </sensor>

      <!-- IMU Sensor -->
      <sensor name="imu_sensor" type="imu">
        <pose>0.0 0.0 0.0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <topic>/model/isonavi_rov/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.001</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><stddev>0.01</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.01</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.01</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- Fluid/Air Pressure (Depth) Sensor -->
      <sensor name="fluid_pressure_sensor" type="air_pressure">
        <pose>-0.100 0.0 0.0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>20.0</update_rate>
        <topic>/model/isonavi_rov/fluid_pressure</topic>
        <air_pressure>
          <reference_altitude>0.0</reference_altitude>
        </air_pressure>
      </sensor>
    </link>

    <!-- ==================================================================== -->
    <!-- 8 THRUSTER LINKS AND JOINTS                                          -->
    <!-- ==================================================================== -->

    <!-- THRUSTER 1 (Fore-Port Horizontal, 45 deg) -->
    <link name="thruster_1">
      <pose>0.215 0.150 -0.060 0 0 0.785398</pose>
      <inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
    </link>
    <joint name="thruster_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_1</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><effort>50</effort><velocity>500</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <!-- THRUSTER 2 (Fore-Starboard Horizontal, -45 deg) -->
    <link name="thruster_2">
      <pose>0.215 -0.150 -0.060 0 0 -0.785398</pose>
      <inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
    </link>
    <joint name="thruster_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_2</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><effort>50</effort><velocity>500</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <!-- THRUSTER 3 (Aft-Port Horizontal, -45 deg) -->
    <link name="thruster_3">
      <pose>-0.215 0.150 -0.060 0 0 -0.785398</pose>
      <inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
    </link>
    <joint name="thruster_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_3</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><effort>50</effort><velocity>500</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <!-- THRUSTER 4 (Aft-Starboard Horizontal, 45 deg) -->
    <link name="thruster_4">
      <pose>-0.215 -0.150 -0.060 0 0 0.785398</pose>
      <inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
    </link>
    <joint name="thruster_4_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_4</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><effort>50</effort><velocity>500</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <!-- THRUSTER 5 (Fore-Port Vertical, +z) -->
    <link name="thruster_5">
      <pose>0.130 0.155 0.100 0 -1.57079632679 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
    </link>
    <joint name="thruster_5_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_5</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><effort>50</effort><velocity>500</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <!-- THRUSTER 6 (Fore-Starboard Vertical, +z) -->
    <link name="thruster_6">
      <pose>0.130 -0.155 0.100 0 -1.57079632679 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
    </link>
    <joint name="thruster_6_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_6</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><effort>50</effort><velocity>500</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <!-- THRUSTER 7 (Aft-Port Vertical, +z) -->
    <link name="thruster_7">
      <pose>-0.130 0.155 0.100 0 -1.57079632679 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
    </link>
    <joint name="thruster_7_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_7</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><effort>50</effort><velocity>500</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <!-- THRUSTER 8 (Aft-Starboard Vertical, +z) -->
    <link name="thruster_8">
      <pose>-0.130 -0.155 0.100 0 -1.57079632679 0</pose>
      <inertial><mass>0.05</mass><inertia><ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz></inertia></inertial>
    </link>
    <joint name="thruster_8_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_8</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><effort>50</effort><velocity>500</velocity></limit>
        <dynamics><damping>0.05</damping><friction>0.01</friction></dynamics>
      </axis>
    </joint>

    <!-- ==================================================================== -->
    <!-- GAZEBO HARMONIC SYSTEMS (PLUGINS)                                    -->
    <!-- ==================================================================== -->

    <!-- Hydrodynamics Plugin: 6-DOF Fossen Formulations -->
    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <disable_added_mass>true</disable_added_mass>
      <!-- Linear Hydrodynamic Damping (Fossen negative convention: N*s/m, N*m*s/rad) -->
      <xU>-15.9</xU>
      <yV>0.0</yV>
      <zW>-38.3</zW>
      <kP>0.0</kP>
      <mQ>-0.93</mQ>
      <nR>0.0</nR>
      <!-- Quadratic Hydrodynamic Form Drag (Fossen negative convention: N*s^2/m^2, N*m*s^2/rad^2) -->
      <xUabsU>-163.6</xUabsU>
      <yVabsV>-251.7</yVabsV>
      <zWabsW>-220.4</zWabsW>
